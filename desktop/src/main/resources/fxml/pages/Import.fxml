<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ImportController" spacing="12" styleClass="import-page,approved-ui,erp-screen-root"><padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="import-page-header,ua-premium-header,erp-page-identity-header"><StackPane fx:id="importPageIcon" styleClass="erp-page-header-icon,import-header-icon-box"/><VBox><Label text="Data Import" styleClass="screen-title"/><Label text="Import ERP master and transaction data from Excel or bank CSV files" styleClass="screen-subtitle"/></VBox><Label fx:id="lblActiveLoaderBadge" text="Purchases Loader" visible="false" managed="false" styleClass="import-active-loader-badge"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnImportGuide" text="Import Guide" onAction="#showImportGuide" styleClass="approved-button,approved-secondary-button"/></HBox>
 <HBox alignment="CENTER" spacing="0" styleClass="import-wizard-bar,import-wizard-group-panel"><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step1Badge" text="1" styleClass="wizard-badge"/><Label text="Select Data" styleClass="wizard-title"/><Label fx:id="lblStep1SubTitle" text="Choose what to import" styleClass="muted-label"/></VBox><Region fx:id="wizardLine1" styleClass="wizard-line,wizard-line-pending" HBox.hgrow="ALWAYS"/><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step2Badge" text="2" styleClass="wizard-badge"/><Label text="Upload File" styleClass="wizard-title"/><Label text="Select your import file" styleClass="muted-label"/></VBox><Region fx:id="wizardLine2" styleClass="wizard-line,wizard-line-pending" HBox.hgrow="ALWAYS"/><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step3Badge" text="3" styleClass="wizard-badge"/><Label text="Map Columns" styleClass="wizard-title"/><Label text="Match file columns to ERP fields" styleClass="muted-label"/></VBox><Region fx:id="wizardLine3" styleClass="wizard-line,wizard-line-pending" HBox.hgrow="ALWAYS"/><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step4Badge" text="4" styleClass="wizard-badge"/><Label text="Review &amp; Import" styleClass="wizard-title"/><Label text="Validate and import data" styleClass="muted-label"/></VBox></HBox>
 <StackPane VBox.vgrow="ALWAYS">
  <VBox fx:id="stepSelect" spacing="12" styleClass="import-card,import-stage-card"><HBox><VBox><Label text="What would you like to import?" styleClass="section-title"/><Label text="Select the type of data you want to import into your ERP" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbImportModule" visible="false" managed="false"/><TextField fx:id="txtImportNote" promptText="Optional import note" prefWidth="260" styleClass="approved-input"/></HBox><GridPane hgap="12" vgap="12" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/></columnConstraints><rowConstraints><RowConstraints percentHeight="50"/><RowConstraints percentHeight="50"/></rowConstraints>
   <VBox spacing="8" styleClass="import-choice-card,template-item"><StackPane fx:id="itemChoiceIcon" styleClass="import-choice-icon"/><Label text="Item Master" styleClass="section-title"/><Label text="Import product items, stock information, pricing and tax details." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectItemMaster" styleClass="primary-button"/><MenuButton fx:id="btnDownloadItemTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.columnIndex="1" spacing="8" styleClass="import-choice-card,template-customer"><StackPane fx:id="customerChoiceIcon" styleClass="import-choice-icon"/><Label text="Customers / CRM" styleClass="section-title"/><Label text="Import customer and CRM information with contact details." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectCustomers" styleClass="primary-button"/><MenuButton fx:id="btnDownloadCustomerTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.columnIndex="2" spacing="8" styleClass="import-choice-card,template-supplier"><StackPane fx:id="supplierChoiceIcon" styleClass="import-choice-icon"/><Label text="Suppliers / HRM" styleClass="section-title"/><Label text="Import supplier and vendor information and contact details." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectSuppliers" styleClass="primary-button"/><MenuButton fx:id="btnDownloadSupplierTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" spacing="8" styleClass="import-choice-card,template-sales"><StackPane fx:id="salesChoiceIcon" styleClass="import-choice-icon"/><Label text="Sales" styleClass="section-title"/><Label text="Import sales invoices, orders and related transaction data." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectSales" styleClass="primary-button"/><MenuButton fx:id="btnDownloadSalesTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="8" styleClass="import-choice-card,template-purchase"><StackPane fx:id="purchaseChoiceIcon" styleClass="import-choice-icon"/><Label text="Purchases" styleClass="section-title"/><Label text="Import purchase invoices, bills and related transaction data." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectPurchases" styleClass="primary-button"/><MenuButton fx:id="btnDownloadPurchaseTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" GridPane.columnIndex="2" spacing="8" styleClass="import-choice-card,template-purchase"><StackPane fx:id="purchaseReconChoiceIcon" styleClass="import-choice-icon"/><Label text="Purchase Recon" styleClass="section-title"/><Label text="Import reconciliation invoices and automatically create missing Recon Suppliers." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectPurchaseRecon" styleClass="primary-button"/><MenuButton fx:id="btnDownloadPurchaseReconTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" GridPane.columnIndex="3" spacing="8" styleClass="import-choice-card,template-bank"><StackPane fx:id="bankStatementChoiceIcon" styleClass="import-choice-icon"/><Label text="Bank Statement" styleClass="section-title"/><Label text="Import a bank statement CSV for reconciliation and transaction matching." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectBankStatement" styleClass="primary-button"/><MenuButton fx:id="btnDownloadBankStatementTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.columnIndex="3" spacing="8" styleClass="import-choice-card,template-master"><StackPane fx:id="masterChoiceIcon" styleClass="import-choice-icon"/><Label text="Master Categories &amp; Values" styleClass="section-title"/><Label text="Import master categories, units, brands and reference data." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8" alignment="CENTER_LEFT"><Button text="Select" minWidth="-Infinity" onAction="#selectMasterValues" styleClass="primary-button"/><MenuButton fx:id="btnDownloadMasterTemplate" text="Template" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
  </GridPane></VBox>
  <VBox fx:id="stepUpload" spacing="14" visible="false" managed="false" styleClass="import-card,import-stage-card"><Label text="Upload Import File" styleClass="section-title"/><Label text="Upload the selected Excel workbook or Bank Statement CSV" styleClass="muted-label"/><HBox spacing="22" VBox.vgrow="ALWAYS" alignment="CENTER"><VBox fx:id="dropZone" alignment="CENTER" spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="import-drop-zone,import-drop-zone-large" onDragOver="#onDragOver" onDragEntered="#onDragEntered" onDragExited="#onDragExited" onDragDropped="#onDragDropped"><Label fx:id="lblDropIcon" styleClass="drop-icon"/><Label text="Drag and drop your import file here" styleClass="drop-title"/><Label text="or" styleClass="muted-label"/><Button fx:id="btnChooseFile" text="Browse File" onAction="#onChooseImportFile" styleClass="primary-button"/><Label text="Supported formats: .xlsx, .xls, Bank Statement .csv  •  Maximum file size: 20 MB" styleClass="muted-label"/></VBox><VBox spacing="12" prefWidth="390" styleClass="import-selected-file-panel"><StackPane fx:id="selectedFileExcelIcon" styleClass="import-selected-excel-icon"/><Label text="Selected File" styleClass="section-title"/><Label fx:id="lblChosenFile" text="No file selected" wrapText="true" styleClass="selected-file"/><Button text="Change File" onAction="#onChooseImportFile" styleClass="approved-button,approved-secondary-button"/></VBox></HBox><HBox><Button text="Back" onAction="#wizardBackToSelect" styleClass="approved-button,approved-secondary-button"/><Region HBox.hgrow="ALWAYS"/><Button text="Continue" onAction="#wizardContinueUpload" styleClass="primary-button"/></HBox></VBox>
  <VBox fx:id="stepMap" spacing="10" visible="false" managed="false" styleClass="import-card,import-stage-card"><HBox alignment="CENTER_LEFT" spacing="10"><VBox><Label text="Map Import Columns to ERP Fields" styleClass="section-title"/><Label fx:id="lblStepMapSubTitle" text="Map each column from the selected import file to the corresponding ERP field." styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblMappingCount" text="0 of 0 fields mapped" styleClass="import-success-text"/><Button text="Back" onAction="#wizardBackToUpload" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnAutoMap" text="Auto Map" onAction="#autoMapColumns" styleClass="primary-button"/><Button fx:id="btnResetMapping" text="Reset Mapping" onAction="#resetMapping" styleClass="approved-button,approved-secondary-button"/><Button text="Continue" onAction="#wizardContinueMap" styleClass="primary-button"/></HBox><ScrollPane fx:id="mappingScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="import-inner-scroll"><GridPane fx:id="gridMapping" minWidth="950" styleClass="import-mapping-grid"/></ScrollPane></VBox>
  <VBox fx:id="stepReview" spacing="10" visible="false" managed="false" styleClass="import-card,import-stage-card"><HBox alignment="CENTER_LEFT" spacing="12"><VBox><Label text="Review &amp; Validate Data" styleClass="section-title"/><Label fx:id="lblStepReviewSubTitle" text="Mapped data stays visible while validation runs in a separate results view." styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><HBox alignment="CENTER_RIGHT" spacing="8" styleClass="import-kpi-pill-box"><Label fx:id="lblKpiChecked" text="0 Checked" styleClass="import-kpi-chip,import-kpi-checked"/><Label fx:id="lblKpiPassed" text="0 Passed" styleClass="import-kpi-chip,import-kpi-passed"/><Label fx:id="lblKpiFailed" text="0 Failed" styleClass="import-kpi-chip,import-kpi-failed"/><Label fx:id="lblKpiSkipped" text="0 Skipped" styleClass="import-kpi-chip,import-kpi-skipped"/><Label fx:id="lblPreviewCount" text="0 rows" visible="false" managed="false"/></HBox></HBox><HBox alignment="CENTER_LEFT" spacing="10" styleClass="import-review-toolbar"><Button text="Back" onAction="#wizardBackToMap" styleClass="approved-button,approved-secondary-button"/><Label text="Existing records:" styleClass="import-toolbar-label"/><ComboBox fx:id="cmbImportMode" prefWidth="290"/><CheckBox fx:id="chkDryRun" text="Validate only (do not save)"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnRevalidate" text="Run Pre-Validation" onAction="#runPreflightValidation" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnRunImport" text="Import Records" onAction="#onRunImport" disable="true" styleClass="primary-button,import-run-button"/></HBox><HBox alignment="CENTER_LEFT" spacing="10" styleClass="import-search-pagination-bar"><TextField fx:id="txtSearchRecords" promptText="🔍 Search Reference No, Row, Status, or Error message..." prefWidth="380" styleClass="approved-input"/><ComboBox fx:id="cmbStatusFilter" prefWidth="150"/><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbPageSize" prefWidth="110"/><Button fx:id="btnPageFirst" text="«" onAction="#onPageFirst" styleClass="approved-button,approved-secondary-button,import-page-btn"/><Button fx:id="btnPagePrev" text="‹" onAction="#onPagePrev" styleClass="approved-button,approved-secondary-button,import-page-btn"/><Label fx:id="lblPaginationInfo" text="Page 1 of 1" styleClass="muted-label,import-page-info"/><Button fx:id="btnPageNext" text="›" onAction="#onPageNext" styleClass="approved-button,approved-secondary-button,import-page-btn"/><Button fx:id="btnPageLast" text="»" onAction="#onPageLast" styleClass="approved-button,approved-secondary-button,import-page-btn"/></HBox><TabPane fx:id="reviewTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="import-review-tabs"><tabs><Tab fx:id="dataPreviewTab" text="Data Preview"><content><TableView fx:id="tblPreview" styleClass="import-preview-table,approved-table,erp-table-profile-import"/></content></Tab><Tab fx:id="validationResultsTab" text="Validation Results"><content><TableView fx:id="tblValidation" styleClass="import-preview-table,approved-table,erp-table-profile-import"/></content></Tab></tabs></TabPane><HBox alignment="CENTER_LEFT" spacing="12" styleClass="import-review-footer-bar"><Label fx:id="lblPreviewStatus" text="No preview loaded" styleClass="approved-status"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblReadyStatus" text="Ready for validation" styleClass="muted-label"/></HBox><VBox fx:id="progressContainer" spacing="5" visible="false" managed="false"><HBox><Label fx:id="lblProgressStatus" text="Importing data..."/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblProgressPercent" text="0%"/></HBox><ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0"/></VBox><VBox fx:id="importCompletedPanel" visible="false" managed="false" alignment="CENTER" spacing="9" styleClass="import-completed-panel"><Label text="✓" styleClass="import-completed-icon"/><Label text="Import Completed Successfully" styleClass="section-title,import-completed-title"/><Label fx:id="lblImportCompletedSummary" text="Import completed" styleClass="import-success-text"/><HBox alignment="CENTER" spacing="10"><Button text="View Imported Records" onAction="#viewImportedRecords" styleClass="primary-button"/><Button text="Start Another Import" onAction="#startAnotherImport" styleClass="approved-button,approved-secondary-button"/><Button text="Close Import" onAction="#closeImport" styleClass="approved-button,approved-secondary-button"/></HBox></VBox></VBox>
   <!-- Dedicated Modal Import Guard Shield (Consumes all clicks and displays 3D Gyro Spinner + Live Progress) -->
   <StackPane fx:id="importShieldOverlay" visible="false" managed="false" styleClass="import-shield-overlay">
    <VBox alignment="CENTER" spacing="16" maxWidth="580" maxHeight="380" styleClass="import-shield-card">
     <StackPane fx:id="shieldGyroHost" prefWidth="64" prefHeight="64" minWidth="64" minHeight="64"/>
     <VBox alignment="CENTER" spacing="6">
      <Label fx:id="lblShieldTitle" text="Importing Data into Financial Ledger" styleClass="import-shield-title"/>
      <Label fx:id="lblShieldDetail" text="Initializing batch transaction…" wrapText="true" styleClass="import-shield-detail"/>
     </VBox>
     <VBox spacing="8" maxWidth="Infinity" styleClass="import-shield-progress-container">
      <HBox alignment="CENTER_LEFT">
       <Label fx:id="lblShieldCounter" text="Booking 0 of 0 records" styleClass="import-shield-counter"/>
       <Region HBox.hgrow="ALWAYS"/>
       <Label fx:id="lblShieldPercent" text="0%" styleClass="import-shield-percent"/>
      </HBox>
      <ProgressBar fx:id="shieldProgressBar" maxWidth="Infinity" progress="0" styleClass="import-shield-progress-bar"/>
     </VBox>
     <HBox alignment="CENTER" spacing="8" styleClass="import-shield-notice-box">
      <Label text="🔒" styleClass="import-shield-lock-icon"/>
      <Label text="Navigation is temporarily locked. Please do not close or leave this screen until data import completes safely." wrapText="true" styleClass="import-shield-notice-text"/>
     </HBox>
    </VBox>
   </StackPane>
 </StackPane>
</VBox>
