<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BankStatementController" styleClass="bank-recon-root,approved-screen,erp-screen-root">
  <top>
    <VBox spacing="10" styleClass="bank-recon-top-stack">
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bank-recon-header,approved-page-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" prefWidth="42" prefHeight="42" styleClass="approved-page-icon,bank-recon-page-icon"/>
        <VBox spacing="2">
          <Label text="Bank Statement" styleClass="approved-page-title"/>
          <Label text="Review and reconcile imported bank transactions" wrapText="true" styleClass="approved-page-subtitle,bank-recon-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="8">
          <Label text="Statement / Bank Account" minWidth="-Infinity" styleClass="bank-recon-field-caption"/>
          <ComboBox fx:id="cmbBatch" prefWidth="320" minWidth="230" promptText="Select statement or consolidated account"/>
        </HBox>
        <Button fx:id="btnBrowseStatements" text="Browse Statements" minWidth="-Infinity" onAction="#toggleStatementHistory" styleClass="approved-button,approved-secondary-button"/>
        <MenuButton fx:id="btnExport" text="Export" minWidth="-Infinity" styleClass="approved-button,approved-secondary-button">
          <items>
            <MenuItem fx:id="miExportExcel" text="Export Filtered Excel" onAction="#exportFilteredExcel"/>
            <MenuItem fx:id="miExportPdf" text="Export Filtered PDF" onAction="#exportFilteredPdf"/>
            <SeparatorMenuItem/>
            <MenuItem fx:id="miExportBrsPdf" text="Export CA BRS Report (PDF)" onAction="#exportBrsPdf"/>
            <MenuItem fx:id="miExportBrsExcel" text="Export CA BRS Workbook (Excel)" onAction="#exportBrsExcel"/>
          </items>
        </MenuButton>
        <Button fx:id="btnDeleteStatement" text="Delete Statement" minWidth="-Infinity" onAction="#deleteCurrentStatement" disable="true" styleClass="approved-button,approved-danger-button"/>
        <Button fx:id="btnImport" text="Import Statement" minWidth="-Infinity" onAction="#importStatement" styleClass="approved-button,approved-primary-button,bank-recon-import-button"/>
        <Button fx:id="btnScreenGuide" contentDisplay="GRAPHIC_ONLY" onAction="#showScreenGuide" styleClass="approved-button,approved-secondary-button,erp-screen-guide-button"/>
      </HBox>

      <GridPane hgap="10" vgap="0" styleClass="bank-recon-kpi-panel,erp-kpi-section,erp-kpi-single-row">
        <VBox fx:id="cardKpiTotal" spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-blue" GridPane.columnIndex="0"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiTotalIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Total Transactions" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiTotal" text="0" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Rows" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
        <VBox fx:id="cardKpiUnmatched" spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-red" GridPane.columnIndex="1"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiUnmatchedIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Unmatched" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiUnmatched" text="0" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Open" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
        <VBox fx:id="cardKpiSuggested" spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-orange" GridPane.columnIndex="2"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiSuggestedIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Suggested" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiSuggested" text="0" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Hints" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
        <VBox fx:id="cardKpiMatched" spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-green" GridPane.columnIndex="3"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiMatchedIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Matched" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiMatched" text="0" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Linked" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
        <VBox fx:id="cardKpiExpense" spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-purple" GridPane.columnIndex="4"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiExpenseIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Expenses" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiExpense" text="0" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Posted" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
        <VBox spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-green" GridPane.columnIndex="5"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiCreditsIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Total Credits" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiCredits" text="0.00" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="In" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
        <VBox spacing="2" minWidth="0" styleClass="standard-kpi-card,bank-recon-kpi,kpi-red" GridPane.columnIndex="6"><HBox alignment="CENTER_LEFT" spacing="6"><StackPane fx:id="kpiDebitsIcon" styleClass="standard-kpi-icon,approved-kpi-icon,bank-recon-kpi-icon"/><Label text="Total Debits" minWidth="0" styleClass="bank-recon-kpi-caption,metric-label"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiDebits" text="0.00" minWidth="-Infinity" styleClass="bank-recon-kpi-value,metric-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Out" minWidth="-Infinity" styleClass="bank-recon-kpi-note,metric-note"/></HBox></VBox>
      </GridPane>

      <HBox fx:id="balanceVerificationBar" alignment="CENTER_LEFT" spacing="10" styleClass="bank-balance-strip,approved-card">
        <Label fx:id="lblScopeBadge" text="Batch Mode" styleClass="bank-balance-pill,bank-balance-neutral"/>
        <HBox alignment="CENTER_LEFT" spacing="5"><Label text="Opening:" styleClass="bank-balance-caption"/><Label fx:id="lblOpeningBalance" text="₹ 0.00" styleClass="bank-balance-num"/></HBox>
        <HBox alignment="CENTER_LEFT" spacing="5"><Label text="Calculated Closing:" styleClass="bank-balance-caption"/><Label fx:id="lblCalculatedClosing" text="₹ 0.00" styleClass="bank-balance-num"/></HBox>
        <HBox alignment="CENTER_LEFT" spacing="5"><Label text="Bank Closing:" styleClass="bank-balance-caption"/><Label fx:id="lblBankClosing" text="₹ 0.00" styleClass="bank-balance-num"/></HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblBatchStatus" text="IMPORTED" minWidth="-Infinity" styleClass="bank-recon-status-badge"/>
        <Label fx:id="lblBalanceStatus" text="Import statement to verify balance" minWidth="-Infinity" styleClass="bank-balance-pill,bank-balance-neutral"/>
      </HBox>
    </VBox>
  </top>

  <center>
    <StackPane fx:id="statementWorkspace" styleClass="bank-recon-workspace,bank-statement-history-overlay">
      <VBox spacing="8" styleClass="bank-recon-main-panel" StackPane.alignment="CENTER">
        <VBox spacing="0" styleClass="bank-recon-filter-panel">
          <!-- Single Compact Filter & Progress Row -->
          <HBox spacing="6" alignment="BOTTOM_LEFT">
            <VBox spacing="2" minWidth="160" prefWidth="230" maxWidth="300" HBox.hgrow="SOMETIMES">
              <Label text="Search" styleClass="bank-recon-field-caption"/>
              <TextField fx:id="txtSearch" promptText="Search narration, reference, amount..." maxWidth="Infinity" onAction="#applyFilters"/>
            </VBox>
            <VBox spacing="2" minWidth="138" prefWidth="144">
              <Label text="From Date" styleClass="bank-recon-field-caption"/>
              <DatePicker fx:id="fromDate" promptText="From" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="2" minWidth="138" prefWidth="144">
              <Label text="To Date" styleClass="bank-recon-field-caption"/>
              <DatePicker fx:id="toDate" promptText="To" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="2" minWidth="140" prefWidth="150">
              <Label text="Reconciliation Status" styleClass="bank-recon-field-caption"/>
              <ComboBox fx:id="cmbStatus" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="2" minWidth="106" prefWidth="114">
              <Label text="Transaction Type" styleClass="bank-recon-field-caption"/>
              <ComboBox fx:id="cmbDirection" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="2" minWidth="128" prefWidth="136">
              <Label text="Channel" styleClass="bank-recon-field-caption"/>
              <ComboBox fx:id="cmbChannel" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="2" minWidth="150" prefWidth="166" styleClass="bank-recon-progress-box">
              <HBox alignment="CENTER_LEFT" spacing="4">
                <Label text="Batch Progress" styleClass="bank-recon-field-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblProgressText" text="0 / 0" minWidth="-Infinity" styleClass="bank-recon-progress-label"/>
              </HBox>
              <VBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
                <ProgressBar fx:id="reconciliationProgress" maxWidth="Infinity" progress="0"/>
              </VBox>
            </VBox>
            <Region minWidth="8" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnReset" text="Reset" minWidth="-Infinity" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button,bank-filter-action"/>
            <Button fx:id="btnRefresh" text="Refresh" minWidth="-Infinity" onAction="#refreshWithFeedback" styleClass="approved-button,approved-secondary-button,bank-filter-action"/>
          </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" styleClass="bank-recon-table-panel">
          <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,bank-recon-table,erp-table-profile-responsive">
            <columns>
              <TableColumn fx:id="colSelect" text="" resizable="false" sortable="false"/>
              <TableColumn fx:id="colStatementRef" text="Line Ref"/>
              <TableColumn fx:id="colDate" text="Date"/>
              <TableColumn fx:id="colReference" text="Ref / Chq No."/>
              <TableColumn fx:id="colDescription" text="Description / Narration"/>
              <TableColumn fx:id="colDebit" text="Debit"/>
              <TableColumn fx:id="colCredit" text="Credit"/>
              <TableColumn fx:id="colBalance" text="Balance"/>
              <TableColumn fx:id="colStatus" text="Status"/>
              <TableColumn fx:id="colMatch" text="Match / Link"/>
              <TableColumn fx:id="colAction" text="Actions" sortable="false" resizable="false"/>
            </columns>
            <placeholder><VBox alignment="CENTER" spacing="8"><Label text="No bank statement transactions to display" styleClass="bank-recon-empty-title"/><Label text="Import a CSV statement or select an existing statement batch." wrapText="true" styleClass="bank-recon-empty-note"/></VBox></placeholder>
          </TableView>
          <HBox alignment="CENTER_LEFT" spacing="5" styleClass="bank-recon-footer">
            <Label fx:id="lblShowing" text="Showing 0 records" minWidth="-Infinity" styleClass="finance-showing-label"/>
            <Button fx:id="btnMoveExpense" text="Move to Expense" minWidth="-Infinity" onAction="#moveSelectedToExpense" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action,bank-footer-action"/>
            <Button fx:id="btnMoveBankEntry" text="Move to Bank Entry" minWidth="-Infinity" onAction="#moveSelectedToBankEntry" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action,bank-footer-action"/>
            <Button fx:id="btnBulkReview" text="Reviewed" minWidth="-Infinity" onAction="#bulkMarkReview" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action,bank-footer-action"/>
            <Button fx:id="btnBulkIgnore" text="Ignore" minWidth="-Infinity" onAction="#bulkIgnore" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action,bank-footer-action"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="btnAutoMatch" text="Auto Match Suggestions" minWidth="-Infinity" onAction="#openAutoMatchDialog" styleClass="approved-button,approved-primary-button,bank-direct-action,bank-footer-action"/>
            <Button fx:id="btnManageRules" text="Rules" minWidth="-Infinity" onAction="#openRulesManager" styleClass="approved-button,approved-secondary-button,bank-direct-action,bank-footer-action"/>
            <Button fx:id="btnApplyRules" text="Run Rules" minWidth="-Infinity" onAction="#runSmartRules" styleClass="approved-button,approved-secondary-button,bank-direct-action,bank-footer-action"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Rows" styleClass="finance-showing-label"/>
            <ComboBox fx:id="cmbPageSize" prefWidth="68" minWidth="62"/>
            <Button fx:id="btnPrevPage" text="Previous" minWidth="-Infinity" onAction="#previousPage" styleClass="approved-button,approved-secondary-button,bank-footer-action"/>
            <Label fx:id="lblPage" text="Page 0 of 0" minWidth="-Infinity" styleClass="finance-showing-label"/>
            <Button fx:id="btnNextPage" text="Next" minWidth="-Infinity" onAction="#nextPage" styleClass="approved-button,approved-secondary-button,bank-footer-action"/>
          </HBox>
        </VBox>
      </VBox>

      <VBox fx:id="statementHistoryDrawer" visible="false" managed="false" minWidth="0" prefWidth="1040" spacing="10" styleClass="bank-statement-history-popup-content">
        <HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="historyIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Bank Statement History" styleClass="section-title"/><Label text="Search and open any previous import without loading the full history into the selector." wrapText="true" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCloseHistory" text="Close" onAction="#closeStatementHistory" styleClass="approved-button,approved-secondary-button"/></HBox>
        <TextField fx:id="txtHistorySearch" promptText="Search bank, account, filename or imported by..." onAction="#searchStatementHistory"/>
        <GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
          <VBox spacing="2"><Label text="Bank / Account" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbHistoryAccount" editable="true" promptText="All Bank Accounts" onAction="#searchStatementHistory" maxWidth="Infinity"/></VBox>
          <VBox GridPane.columnIndex="1" spacing="2"><Label text="Status" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbHistoryStatus" maxWidth="Infinity"/></VBox>
          <VBox GridPane.rowIndex="1" spacing="2"><Label text="Statement From" styleClass="bank-recon-field-caption"/><DatePicker fx:id="historyFrom" maxWidth="Infinity"/></VBox>
          <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="2"><Label text="Statement To" styleClass="bank-recon-field-caption"/><DatePicker fx:id="historyTo" maxWidth="Infinity"/></VBox>
        </GridPane>
        <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Reset" onAction="#resetStatementHistory" styleClass="approved-button,approved-secondary-button"/><Button text="Search" onAction="#searchStatementHistory" styleClass="approved-button,approved-secondary-button"/></HBox>
        <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS" minHeight="140" prefHeight="220" styleClass="approved-table,erp-table-profile-responsive,bank-statement-history-table"><columns><TableColumn fx:id="colHistoryImported" text="Imported"/><TableColumn fx:id="colHistoryBank" text="Bank / Account"/><TableColumn fx:id="colHistoryPeriod" text="Statement Period"/><TableColumn fx:id="colHistoryStatus" text="Status"/><TableColumn fx:id="colHistoryRows" text="Rows"/></columns></TableView>
        <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="lblHistoryShowing" text="Showing 0 statements" styleClass="finance-showing-label"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnHistoryPrev" text="Previous" onAction="#previousStatementHistoryPage" styleClass="approved-button,approved-secondary-button"/><Label fx:id="lblHistoryPage" text="Page 0 of 0" styleClass="finance-showing-label"/><Button fx:id="btnHistoryNext" text="Next" onAction="#nextStatementHistoryPage" styleClass="approved-button,approved-secondary-button"/></HBox>
        <HBox spacing="8" styleClass="bank-statement-history-actions"><Button fx:id="btnHistoryDelete" text="Delete Statement" onAction="#deleteSelectedHistory" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minHeight="38" prefHeight="38" styleClass="approved-button,approved-danger-button"/><Button fx:id="btnOpenStatement" text="Open Statement" onAction="#openSelectedHistory" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minHeight="38" prefHeight="38" styleClass="approved-button,approved-primary-button"/></HBox>
      </VBox>
    </StackPane>
  </center>
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
</BorderPane>
