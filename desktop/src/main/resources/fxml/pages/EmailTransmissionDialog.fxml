<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.EmailTransmissionDialog"
            prefWidth="860" prefHeight="780" minWidth="760" minHeight="620"
            styleClass="entity-dialog,premium-entity-dialog,approved-ui">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="edge-to-edge,email-transmission-scroll">
            <VBox spacing="14" styleClass="premium-dialog-content">
                <padding>
                    <Insets top="16" right="20" bottom="16" left="20"/>
                </padding>

                <!-- From / Sender Identity (Active when Activity-Based Routing is ON) -->
                <VBox fx:id="boxSenderProfile" spacing="6" managed="false" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="From / Sender Identity *" styleClass="field-label,settings-form-label,email-transmission-field-bold"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Department mailbox route" styleClass="page-subtitle,email-transmission-hint"/>
                    </HBox>
                    <ComboBox fx:id="cmbSenderProfile" maxWidth="Infinity" styleClass="approved-combo"/>
                </VBox>

                <!-- Recipient Email -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Recipient Email Address *" styleClass="field-label,settings-form-label,email-transmission-field-bold"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Direct delivery target" styleClass="page-subtitle,email-transmission-hint"/>
                    </HBox>
                    <TextField fx:id="txtRecipient" promptText="name@example.com" styleClass="approved-input"/>
                    <Label fx:id="errRecipient" text="Valid recipient email address is required" visible="false" managed="false" styleClass="validation-message,email-transmission-error"/>
                </VBox>

                <!-- Subject -->
                <VBox spacing="6">
                    <Label text="Subject *" styleClass="field-label,settings-form-label,email-transmission-field-bold"/>
                    <TextField fx:id="txtSubject" promptText="Enter email subject" styleClass="approved-input"/>
                    <Label fx:id="errSubject" text="Email subject cannot be blank" visible="false" managed="false" styleClass="validation-message,email-transmission-error"/>
                </VBox>

                <!-- Message Body & Executive Preview Switcher -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Message Content" styleClass="field-label,settings-form-label,email-transmission-field-bold"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="4">
                            <Button fx:id="btnTabEdit" text="✍ Edit Text" onAction="#showEditMode" styleClass="secondary-button,approved-secondary-button"/>
                            <Button fx:id="btnTabPreview" text="👁 Executive Preview" onAction="#showPreviewMode" styleClass="secondary-button,approved-secondary-button"/>
                            <Button fx:id="btnPreviewHtml" text="🌐 Preview Real HTML" onAction="#previewHtmlInBrowser" styleClass="secondary-button,approved-secondary-button"/>
                        </HBox>
                    </HBox>
                    <StackPane VBox.vgrow="ALWAYS" minHeight="240">
                        <TextArea fx:id="txtBody" prefRowCount="10" minHeight="220" prefHeight="260" wrapText="true" styleClass="email-transmission-body-area"/>
                        <VBox fx:id="boxExecutivePreview" visible="false" managed="false" spacing="12" styleClass="settings-card" minHeight="240">
                            <!-- Branded Letterhead Header -->
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="email-preview-header">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lblPreviewCompany" text="JASVI INDUSTRIES" styleClass="font-bold"/>
                                    <Label text="INDUSTRIAL MACHINERY &amp; ENGINEERING SOLUTIONS" styleClass="muted-text"/>
                                </VBox>
                                <Label fx:id="lblPreviewBadge" text="OFFICIAL" styleClass="status-pill,status-pill-info"/>
                            </HBox>
                            <GridPane hgap="14" vgap="6">
                                <Label text="Document:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="muted-text"/>
                                <Label fx:id="lblPreviewDocNo" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="font-bold"/>
                                <Label text="Recipient:" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="muted-text"/>
                                <Label fx:id="lblPreviewRecipient" text="-" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="font-bold"/>
                                <Label text="Total Value:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="muted-text"/>
                                <Label fx:id="lblPreviewAmount" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="accent-text"/>
                                <Label text="Status:" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="muted-text"/>
                                <Label fx:id="lblPreviewStatus" text="-" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="font-bold"/>
                            </GridPane>
                            <!-- Live Status CTA Preview Button -->
                            <HBox fx:id="boxLiveStatusPreview" alignment="CENTER" spacing="10" styleClass="email-preview-cta-box">
                                <Button fx:id="btnLiveStatusSample" text="🔍 VIEW LIVE PAYMENT &amp; INVOICE STATUS" styleClass="approved-primary-button"/>
                            </HBox>
                            <ScrollPane fitToWidth="true" prefHeight="130" styleClass="edge-to-edge">
                                <Label fx:id="lblPreviewBody" wrapText="true" styleClass="email-preview-body-prose"/>
                            </ScrollPane>
                        </VBox>
                    </StackPane>
                </VBox>

                <!-- Signature / Stamp Image Card (if configured) -->
                <HBox fx:id="boxSignatureImage" alignment="CENTER_LEFT" spacing="12"
                      styleClass="email-transmission-sig-box">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Company Signature / Stamp Attached" styleClass="email-transmission-sig-title"/>
                        <Label fx:id="lblSignatureImageInfo" text="Appended automatically below message signature" styleClass="email-transmission-sig-info"/>
                    </VBox>
                    <StackPane styleClass="email-transmission-sig-thumb-holder" minWidth="70" minHeight="36" prefWidth="80" prefHeight="38">
                        <ImageView fx:id="imgSignatureThumb" fitHeight="34" fitWidth="76" preserveRatio="true" smooth="true"/>
                    </StackPane>
                    <Button fx:id="btnPreviewSignature" text="Preview Signature" onAction="#previewSignature"
                            styleClass="email-transmission-preview-btn"/>
                    <Label text="SIGNATURE" styleClass="email-transmission-sig-badge"/>
                </HBox>

                <!-- Document Attachment Box (Matching Web Parity) -->
                <HBox fx:id="boxAttachment" alignment="CENTER_LEFT" spacing="12"
                      styleClass="email-transmission-attach-box">
                    <StackPane fx:id="attachIconHolder" minWidth="26" minHeight="26"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblAttachmentName" text="Tax_Invoice.pdf" styleClass="email-transmission-attach-name"/>
                        <Label fx:id="lblAttachmentDesc" text="Official document PDF attached automatically" styleClass="email-transmission-attach-desc"/>
                    </VBox>
                    <Button fx:id="btnPreviewPdf" text="Preview PDF" onAction="#previewPdf"
                            styleClass="email-transmission-preview-btn"/>
                    <Label text="ATTACHED" styleClass="email-transmission-attached-badge"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="entity-dialog-actions,premium-dialog-actions,email-transmission-actions">
            <Button fx:id="btnCancel" text="Cancel" onAction="#cancel" styleClass="secondary-button" cancelButton="true" prefHeight="36"/>
            <Button fx:id="btnSend" text="Send Tax Invoice" onAction="#send" styleClass="primary-button,approved-primary-button,email-transmission-send-btn" defaultButton="true" prefHeight="36"/>
        </HBox>
    </bottom>
</BorderPane>
