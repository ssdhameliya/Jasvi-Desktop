<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ClientTemplateController"
      spacing="14" styleClass="client-template-page,approved-screen,erp-screen-root">

    <!-- 1. Header Identity Strip -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-page-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" prefWidth="42" prefHeight="42" styleClass="approved-page-icon,template-page-icon"/>
        <VBox spacing="2">
            <Label text="Invoice Template Builder &amp; Versioning" styleClass="approved-page-title"/>
            <Label text="Define document headers and item-level column blueprints for accurate, zero-dummy OCR extraction"
                   styleClass="approved-page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnScreenGuide" contentDisplay="GRAPHIC_ONLY" onAction="#handleShowGuide"
                styleClass="approved-button,approved-secondary-button,erp-screen-guide-button"/>
        <Button fx:id="btnLockTemplate" text="Lock &amp; Save Template Version" onAction="#handleLockTemplate"
                styleClass="approved-button,approved-primary-button"/>
        <Button fx:id="btnBackToDirectory" text="Back to Clients" onAction="#handleBackToDirectory"
                styleClass="approved-button,approved-secondary-button"/>
    </HBox>

    <!-- 2. PANE 1: Single-Row Client Selector, Template Versions & Action Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="approved-card,template-profile-card,template-toolbar-card">
        <StackPane fx:id="iconClientSelect" styleClass="metric-icon-small"/>
        <Label text="Select Client:" minWidth="-Infinity" styleClass="field-label,accent-label-blue"/>
        <ComboBox fx:id="cmbClientProfile" promptText="Select client or type name / GSTIN..."
                  minWidth="230" prefWidth="310" maxWidth="390" HBox.hgrow="SOMETIMES" styleClass="approved-input"/>
        <Separator orientation="VERTICAL" styleClass="template-toolbar-divider"/>
        <HBox fx:id="boxVersionPills" spacing="6" alignment="CENTER_LEFT"/>
        <Button fx:id="btnNewVersion" text="New Version" minWidth="-Infinity" onAction="#handleNewVersion"
                styleClass="approved-button,approved-primary-button,compact-action-button"/>
        <Button fx:id="btnDeleteVersion" text="Delete Version" minWidth="-Infinity" onAction="#handleDeleteVersion"
                styleClass="approved-button,btn-danger,compact-action-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnUploadSample" text="Upload Sample Bill" minWidth="-Infinity" onAction="#handleUploadSample"
                styleClass="approved-button,approved-primary-button"/>
        <Button fx:id="btnViewTemplateDoc" text="View Template Document" minWidth="-Infinity" onAction="#handleViewTemplateDoc"
                styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="btnViewFullGst" text="View Full GST Details" minWidth="-Infinity" onAction="#handleViewFullGst"
                styleClass="approved-button,approved-secondary-button"/>
    </HBox>

    <!-- 3. PANE 2: Dedicated Colorized GSTIN & Taxpayer Intelligence Strip -->
    <GridPane hgap="10" vgap="6" styleClass="approved-card,gst-live-summary-grid,template-gst-detail-card">
        <columnConstraints>
            <ColumnConstraints percentWidth="22"/>
            <ColumnConstraints percentWidth="17"/>
            <ColumnConstraints percentWidth="18"/>
            <ColumnConstraints percentWidth="29"/>
            <ColumnConstraints percentWidth="14"/>
        </columnConstraints>

        <VBox spacing="3" GridPane.columnIndex="0" styleClass="template-gst-tile,template-gst-tile-purple">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane fx:id="iconTrade" styleClass="metric-icon-small"/>
                <Label text="Legal &amp; Trade Name" styleClass="caption-label,accent-label-purple"/>
            </HBox>
            <Label fx:id="lblFirmName" text="Select a client above" wrapText="true" styleClass="bold-value-label,template-gst-value-purple"/>
            <Label fx:id="lblLegalNameSub" text="" wrapText="true" visible="false" managed="false" styleClass="template-gst-subvalue"/>
        </VBox>

        <VBox spacing="3" GridPane.columnIndex="1" styleClass="template-gst-tile,template-gst-tile-blue">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane fx:id="iconGstin" styleClass="metric-icon-small"/>
                <Label text="Vendor GSTIN" styleClass="caption-label,accent-label-blue"/>
            </HBox>
            <Label fx:id="lblGstin" text="—" wrapText="true" styleClass="gstin-badge-text,template-gst-value-blue"/>
            <Label fx:id="lblStateJurisdiction" text="—" wrapText="true" styleClass="template-gst-subvalue"/>
        </VBox>

        <VBox spacing="3" GridPane.columnIndex="2" styleClass="template-gst-tile,template-gst-tile-indigo">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane fx:id="iconTaxpayer" styleClass="metric-icon-small"/>
                <Label text="Taxpayer Profile" styleClass="caption-label,accent-label-indigo"/>
            </HBox>
            <Label fx:id="lblTaxpayerType" text="—" wrapText="true" styleClass="bold-value-label,template-gst-value-indigo"/>
            <Label fx:id="lblRegDate" text="—" wrapText="true" styleClass="template-gst-subvalue"/>
        </VBox>

        <VBox spacing="3" GridPane.columnIndex="3" styleClass="template-gst-tile,template-gst-tile-amber">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane fx:id="iconAddress" styleClass="metric-icon-small"/>
                <Label text="Registered Address" styleClass="caption-label,accent-label-amber"/>
            </HBox>
            <Label fx:id="lblAddress" text="—" wrapText="true" styleClass="address-summary-text,template-gst-value-amber"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="4" alignment="TOP_LEFT" styleClass="template-gst-tile,template-gst-tile-green">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane fx:id="iconStatus" styleClass="metric-icon-small"/>
                <Label text="Portal &amp; Template" styleClass="caption-label,accent-label-green"/>
            </HBox>
            <Label fx:id="lblGstStatus" text="ACTIVE" minWidth="-Infinity" styleClass="status-badge,status-active"/>
            <Label fx:id="lblLockStatus" text="DRAFT (Editable)" wrapText="true" styleClass="lock-status-badge,erp-badge-amber"/>
        </VBox>
    </GridPane>

    <!-- 3. Dynamic 2-Tab Blueprint Workspace (Eliminating all cramped scrollbars) -->
    <TabPane fx:id="tabPaneBlueprint" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="approved-tab-pane,erp-tabs">
        <!-- TAB 1: High-Level Document Headers Blueprint -->
        <Tab fx:id="tabDocumentHeaders" text="High-Level Document Headers Blueprint">
            <VBox spacing="8" styleClass="approved-card,template-headers-card" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="High-Level Document Headers Blueprint" styleClass="section-card-title"/>
                    <Label text="(Document-level headers extracted from bill top e.g. Invoice No, Date, PO, Taxes, Total)"
                           styleClass="caption-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAddHeaderField" text="+ Add Header Field" onAction="#handleAddHeaderField"
                            styleClass="approved-button,approved-secondary-button,compact-action-button"/>
                    <Button fx:id="btnResetHeaders" text="Reset Standard Headers" onAction="#handleResetHeaders"
                            styleClass="approved-button,approved-secondary-button,compact-action-button"/>
                </HBox>
                <TableView fx:id="tableDocumentHeaders" VBox.vgrow="ALWAYS" styleClass="approved-table,headers-blueprint-table">
                    <columns>
                        <TableColumn fx:id="colHdrOrder" text="Order"/>
                        <TableColumn fx:id="colHdrLabel" text="Header Label"/>
                        <TableColumn fx:id="colHdrCanonical" text="Mapped Field"/>
                        <TableColumn fx:id="colHdrSample" text="Sample Extracted Value"/>
                        <TableColumn fx:id="colHdrRequired" text="Required"/>
                        <TableColumn fx:id="colHdrActions" text="Actions"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 2: Item-Level Table Columns Blueprint -->
        <Tab fx:id="tabItemColumns" text="Item-Level Table Columns Blueprint">
            <VBox VBox.vgrow="ALWAYS" spacing="8" styleClass="approved-card,template-items-card">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Item-Level Table Column Blueprint" styleClass="section-card-title"/>
                    <Label text="(Columns extracted from line items table. These define the dynamic table headers in Bill to Tally)"
                           styleClass="caption-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAddColumn" text="+ Add Column Header" onAction="#handleAddColumn"
                            styleClass="approved-button,approved-secondary-button,compact-action-button"/>
                    <Button fx:id="btnReDetect" text="Re-Detect from Sample" onAction="#handleReDetect"
                            styleClass="approved-button,approved-secondary-button,compact-action-button"/>
                </HBox>
                <TableView fx:id="tableColumnsBlueprint" VBox.vgrow="ALWAYS" styleClass="approved-table,columns-blueprint-table">
                    <columns>
                        <TableColumn fx:id="colOrder" text="Order"/>
                        <TableColumn fx:id="colHeaderLabel" text="Header Label"/>
                        <TableColumn fx:id="colCanonicalField" text="Mapped Field"/>
                        <TableColumn fx:id="colDataType" text="Data Type"/>
                        <TableColumn fx:id="colRequired" text="Required"/>
                        <TableColumn fx:id="colActions" text="Actions"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
