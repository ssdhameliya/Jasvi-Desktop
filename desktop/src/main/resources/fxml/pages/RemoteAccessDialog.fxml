<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.RemoteAccessDialogController"
            prefWidth="1050" prefHeight="680" minWidth="920" minHeight="560" maxWidth="Infinity" maxHeight="Infinity"
            styleClass="entity-dialog,premium-entity-dialog,remote-access-dialog,approved-ui,approved-screen,erp-screen-root,document-inspection-host">
    <top>
        <HBox fx:id="heroHeader" alignment="CENTER_LEFT" spacing="14"
              styleClass="erp-page-identity-header,approved-card,entity-dialog-header">
            <StackPane fx:id="headerIconHolder" minWidth="44" minHeight="44" prefWidth="44" prefHeight="44"
                       styleClass="erp-page-header-icon,dialog-title-icon,auth-logo-badge"/>
            <VBox spacing="2">
                <Label text="Remote Branch Workstation Gateway"
                       styleClass="section-title,erp-page-title,approved-strong-label,entity-dialog-title"/>
                <Label text="Encrypted multi-branch connection bridge for authorized branch desktop workstations (₹0 Cloud Hosting Cost)"
                       styleClass="muted-label,erp-page-subtitle,entity-dialog-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTunnelStatusBadge" text="OFFLINE" styleClass="status-badge,badge-inactive"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane,erp-dialog-scroll">
            <VBox spacing="14" styleClass="premium-dialog-content">
                <!-- Card 1: Custom Corporate Domain & Tunnel Configuration -->
                <VBox spacing="12" styleClass="approved-card,form-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="section-header-row">
                        <Label text="1. COMPANY CUSTOM URL &amp; TUNNEL CONFIGURATION"
                               styleClass="dialog-section-title,approved-strong-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Administrator Control" styleClass="status-badge,status-info"/>
                    </HBox>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="190" prefWidth="210"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Custom Corporate Domain:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                            <TextField fx:id="txtCustomDomain" promptText="e.g. https://remote.yourcompany.com" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                            <Button fx:id="btnSaveCustomDomain" text="Save Configuration" onAction="#handleSaveCustomConfig" styleClass="secondary-button,approved-secondary-button"/>
                        </HBox>

                        <Label text="Tunnel Token (Optional):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="txtTunnelToken" promptText="Leave empty for instant zero-config Quick Tunnel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="approved-input"/>
                    </GridPane>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Secure Cloudflare Tunnel Service" styleClass="field-label,approved-strong-label"/>
                            <Label text="Establishes an encrypted high-speed HTTPS tunnel mapping your local Jasvi PostgreSQL backend to remote branch workstations."
                                   wrapText="true" styleClass="field-help,muted-label"/>
                        </VBox>
                        <Button fx:id="btnToggleTunnel" text="Start Remote Sharing" onAction="#handleToggleTunnel"
                                styleClass="primary-button,approved-primary-button"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Live Secure Endpoint URL" styleClass="field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtLiveUrl" promptText="Tunnel is currently offline" editable="false"
                                       HBox.hgrow="ALWAYS" styleClass="approved-input,readonly-field"/>
                            <Button fx:id="btnCopyUrl" text="Copy URL" onAction="#handleCopyUrl"
                                    styleClass="secondary-button,approved-secondary-button"/>
                            <Button fx:id="btnOpenBrowser" text="Open in Browser" onAction="#handleOpenBrowser"
                                    styleClass="secondary-button,approved-secondary-button"/>
                        </HBox>
                        <Label fx:id="lblTunnelUptime" text="Uptime: 00:00:00" styleClass="field-help,muted-label"/>
                    </VBox>
                </VBox>

                <!-- Card 2: Branch Workstation Connection Instructions -->
                <VBox spacing="10" styleClass="approved-card,form-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="section-header-row">
                        <Label text="2. BRANCH WORKSTATION CONNECTION INSTRUCTIONS"
                               styleClass="dialog-section-title,approved-strong-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Branch Synchronization" styleClass="status-badge,badge-active"/>
                    </HBox>
                    <VBox spacing="8" styleClass="field-help-list">
                        <Label text="1. On the branch office desktop computer, launch the Jasvi Desktop application." styleClass="field-help,muted-label"/>
                        <Label text="2. Navigate to Settings &gt; Server Gateway." styleClass="field-help,muted-label"/>
                        <Label text="3. Paste this Live Endpoint URL (or your saved company domain) into the Server URL field and click Connect." styleClass="field-help,muted-label"/>
                        <Label text="4. Communication is encrypted end-to-end via TLS 1.3 with zero inbound port-forwarding required." styleClass="field-help,muted-label"/>
                        <Label text="5. Active gateway endpoints are synchronized to the Master Licensor for technical troubleshooting and remote support." styleClass="field-help,muted-label"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12"
              styleClass="entity-dialog-actions,premium-dialog-actions,erp-action-dock,approved-card">
            <Label text="Encrypted Gateway Active  •  Press [Esc] to Close" styleClass="muted-label,shortcut-hint-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnClose" text="Done / Close" onAction="#handleClose"
                    styleClass="primary-button,approved-primary-button" cancelButton="true" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
