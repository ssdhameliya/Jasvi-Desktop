<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SettingsController" styleClass="settings-page-shell,approved-ui,approved-screen,approved-screen-settings,erp-screen-root">
    <!-- =====================================================
         HEADER
         ===================================================== -->
    <top>
        <VBox spacing="0">
            <HBox fx:id="settingsPageHeader" alignment="CENTER_LEFT" spacing="12" styleClass="page-heading,erp-page-identity-header">

                <StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="settings-page-icon-box">
                    <SVGPath content="M8.8 2h2.4l.5 2a6.8 6.8 0 0 1 1.5.9l2-.6 1.2 2.1-1.5 1.4c.1.5.1 1 0 1.5l1.5 1.4-1.2 2.1-2-.6c-.5.4-1 .7-1.5.9l-.5 2H8.8l-.5-2a6.8 6.8 0 0 1-1.5-.9l-2 .6-1.2-2.1 1.5-1.4a6 6 0 0 1 0-1.5L3.6 6.4l1.2-2.1 2 .6c.5-.4 1-.7 1.5-.9l.5-2zM10 7a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" styleClass="settings-page-icon-svg"/>
                </StackPane>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Settings" styleClass="settings-page-title"/>
                    <Label text="Company configuration, payments, invoices, communication delivery and system administration" wrapText="true" styleClass="settings-page-description"/>
                </VBox>

                <Button fx:id="btnSectionGuide" text="Section Guide" onAction="#showSectionGuide" styleClass="settings-action-button,settings-secondary-button,erp-screen-guide-button">
                    <graphic>
                        <SVGPath content="M11 9h2V7h-2v2zm1 11c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-18C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h2v-6h-2v6z" styleClass="settings-button-icon"/>
                    </graphic>
                </Button>

                <Button fx:id="btnTestEmail" text="Test Email" onAction="#testEmail" styleClass="settings-action-button,settings-secondary-button">
                    <graphic>
                        <SVGPath content="M2 4h16v12H2V4zm2 2v.3l6 4.2 6-4.2V6H4zm12 8V8.7l-5.4 3.8a1 1 0 0 1-1.2 0L4 8.7V14h12z" styleClass="settings-button-icon"/>
                    </graphic>
                </Button>

                <Button fx:id="btnSaveSettings" text="Save Settings" onAction="#save" defaultButton="true" styleClass="settings-action-button,settings-primary-button">
                    <graphic>
                        <SVGPath content="M3 2h11l3 3v12H3V2zm2 2v4h8V4H5zm1 8v3h8v-3H6z" styleClass="settings-button-icon"/>
                    </graphic>
                </Button>

            </HBox>

            <!-- Top Category Navigation Bar (Reporting Dashboard pattern) -->
            <ScrollPane fitToHeight="true" fitToWidth="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" styleClass="clean-scroll,settings-category-strip-scroll">
                <content>
                    <HBox fx:id="settingsCategoryBar" alignment="CENTER_LEFT" spacing="6" styleClass="settings-category-strip,approved-card,approved-surface">
                        <Button fx:id="btnTabCompany" text="Company &amp; Profile" onAction="#showCompany" styleClass="settings-tab-btn,erp-semantic-blue">
                            <graphic>
                                <SVGPath content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabPayment" text="Payment &amp; Bank" onAction="#showPayment" styleClass="settings-tab-btn,erp-semantic-cyan">
                            <graphic>
                                <SVGPath content="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabInvoice" text="Invoice &amp; Delivery" onAction="#showInvoice" styleClass="settings-tab-btn,erp-semantic-orange">
                            <graphic>
                                <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabEmail" text="Email Configuration" onAction="#showEmail" styleClass="settings-tab-btn,erp-semantic-sky">
                            <graphic>
                                <SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabWhatsapp" text="WhatsApp &amp; WAHA" onAction="#showWhatsapp" styleClass="settings-tab-btn,erp-semantic-green">
                            <graphic>
                                <SVGPath content="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabNotifications" text="Notifications" onAction="#showNotifications" styleClass="settings-tab-btn,erp-semantic-amber">
                            <graphic>
                                <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabSecurity" text="Security &amp; Session" onAction="#showSecurity" styleClass="settings-tab-btn,erp-semantic-coral">
                            <graphic>
                                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v2h-2V7zm0 4h2v6h-2v-6z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabWorkspace" text="Workspace &amp; Storage" onAction="#showWorkspace" styleClass="settings-tab-btn,erp-semantic-teal">
                            <graphic>
                                <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabShortcuts" text="Shortcuts" onAction="#showShortcuts" styleClass="settings-tab-btn,erp-semantic-purple">
                            <graphic>
                                <SVGPath content="M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabUpdates" text="Application Updates" onAction="#showUpdates" styleClass="settings-tab-btn,erp-semantic-indigo">
                            <graphic>
                                <SVGPath content="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabModules" text="Module Activation" onAction="#showModules" styleClass="settings-tab-btn,erp-semantic-pink">
                            <graphic>
                                <SVGPath content="M4 11h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm10 0h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zM4 21h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm10 0h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1z" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                        <Button fx:id="btnTabShowcase" text="3D Showcase" onAction="#showShowcase" styleClass="settings-tab-btn,erp-semantic-cyan">
                            <graphic>
                                <SVGPath content="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" styleClass="settings-button-icon"/>
                            </graphic>
                        </Button>
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>
    </top>

    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->
    <center>
        <VBox spacing="8" styleClass="settings-content,settings-workspace-layout">
            <ScrollPane fx:id="panelScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="clean-scroll,settings-panel-scroll,settings-workspace-panel-scroll">
                <content>
                    <StackPane fx:id="panelHost" maxWidth="Infinity" styleClass="settings-panel-host">
                    </StackPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
