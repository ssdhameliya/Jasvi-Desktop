<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ReconSupplierController" spacing="12" styleClass="recon-page,recon-register-page,approved-ui,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,approved-card"><StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Recon Supplier" styleClass="screen-title"/><Label text="Independent supplier master used only by Purchase Recon" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNew" text="New Recon Supplier" onAction="#newSupplier" styleClass="approved-button,approved-primary-button"/></HBox>
 <HBox spacing="8" styleClass="standard-kpi-row,recon-metric-row,erp-kpi-section">
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-blue"><StackPane fx:id="kpiTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total Suppliers" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="All" styleClass="metric-trend-pill,trend-neutral"/></HBox><Label fx:id="kpiTotal" text="0" styleClass="metric-value"/><Label text="Recon supplier master" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-green"><StackPane fx:id="kpiActiveIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Active" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Live" styleClass="metric-trend-pill,trend-positive"/></HBox><Label fx:id="kpiActive" text="0" styleClass="metric-value"/><Label text="Available for reconciliation" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-purple"><StackPane fx:id="kpiImportIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Imported" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Auto" styleClass="metric-trend-pill,trend-info"/></HBox><Label fx:id="kpiImported" text="0" styleClass="metric-value"/><Label text="Created by Purchase Recon import" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-orange"><StackPane fx:id="kpiReconIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Recon Records" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Linked" styleClass="metric-trend-pill,trend-warning"/></HBox><Label fx:id="kpiRecons" text="0" styleClass="metric-value"/><Label text="Linked Purchase Recon records" wrapText="true" styleClass="metric-note"/></VBox></HBox>
 </HBox>
 <HBox fx:id="workspaceRow" spacing="12" VBox.vgrow="ALWAYS">
  <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="approved-card">
   <HBox alignment="CENTER_LEFT" spacing="8">
    <Label text="Recon Supplier Register" styleClass="section-title"/>
    <Region HBox.hgrow="ALWAYS"/>
    <StackPane prefWidth="340" minWidth="260" maxWidth="380" styleClass="erp-item-search-shell,register-header-search-shell">
     <TextField fx:id="txtSearch" promptText="Search reference, name, GSTIN, phone..." maxWidth="Infinity" onAction="#applySearch" styleClass="approved-input,erp-item-search,register-header-search-input"/>
     <StackPane fx:id="searchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon">
      <StackPane.margin><Insets right="8"/></StackPane.margin>
     </StackPane>
    </StackPane>
    <Button fx:id="btnSearch" text="Search" onAction="#applySearch" styleClass="approved-button,approved-secondary-button"/>
    <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/>
    <Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportExcel" styleClass="approved-button,approved-secondary-button"/>
   </HBox>
   <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
    <columns>
     <TableColumn fx:id="colRef" text="Reference"/>
     <TableColumn fx:id="colName" text="Legal / Trade Name"/>
     <TableColumn fx:id="colGstin" text="GSTIN"/>
     <TableColumn fx:id="colPhone" text="Phone"/>
     <TableColumn fx:id="colCount" text="Recon Records"/>
     <TableColumn fx:id="colSource" text="Source"/>
     <TableColumn fx:id="colStatus" text="Status"/>
     <TableColumn fx:id="colAction" text="Actions" sortable="false"/>
    </columns>
   </TableView>
   <HBox alignment="CENTER_LEFT" spacing="10" styleClass="bank-recon-footer">
    <Label fx:id="lblShowing" text="Showing 0 records" styleClass="finance-showing-label"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label text="Rows" styleClass="finance-showing-label"/>
    <ComboBox fx:id="cmbPageSize" prefWidth="92"/>
    <Button fx:id="btnPrevPage" text="Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/>
    <Label fx:id="lblPage" text="Page 0 of 0" styleClass="finance-showing-label"/>
    <Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/>
   </HBox>
  </VBox>
  <VBox fx:id="editorPanel" spacing="10" styleClass="approved-card,recon-editor-panel">
   <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
   <!-- Slim Single-Line Reference Strip (Outer AppDialogRenderer header already shows dialog title) -->
   <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-highlight-strip">
    <Label fx:id="lblEditorTitle" text="New Recon Supplier" minWidth="-Infinity" styleClass="section-title"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="lblReference" text="Reference generated on save" minWidth="-Infinity" styleClass="approved-status"/>
   </HBox>

   <!-- Compact 6-Column, 4-Row Responsive Form Grid (~500px total dialog height, Zero Clipping) -->
   <GridPane hgap="14" vgap="10">
    <columnConstraints>
     <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS"/>
     <ColumnConstraints percentWidth="16.67" hgrow="ALWAYS"/>
     <ColumnConstraints percentWidth="16.67" hgrow="ALWAYS"/>
     <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS"/>
     <ColumnConstraints percentWidth="16.67" hgrow="ALWAYS"/>
     <ColumnConstraints percentWidth="16.67" hgrow="ALWAYS"/>
    </columnConstraints>

    <!-- Row 0: Trade / Legal Name (66%) & Status (34%) -->
    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="4">
     <Label text="Trade / Legal Name" styleClass="field-label"/>
     <TextField fx:id="txtName" promptText="Recon supplier name" styleClass="approved-input"/>
    </VBox>
    <VBox spacing="4" GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.columnSpan="2">
     <Label text="Status" styleClass="field-label"/>
     <ComboBox fx:id="cmbStatus" maxWidth="Infinity" styleClass="approved-input"/>
    </VBox>

    <!-- Row 1: Supplier Reference (33%), GSTIN (33%) & PAN (34%) -->
    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
     <Label text="Supplier Reference (Auto-Generated)" styleClass="field-label"/>
     <TextField fx:id="txtReference" editable="false" promptText="Auto-generated reference" styleClass="approved-input"/>
    </VBox>
    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2">
     <Label text="GSTIN" styleClass="field-label"/>
     <TextField fx:id="txtGstin" promptText="GSTIN (unique when present)" styleClass="approved-input"/>
    </VBox>
    <VBox spacing="4" GridPane.columnIndex="4" GridPane.rowIndex="1" GridPane.columnSpan="2">
     <Label text="PAN" styleClass="field-label"/>
     <TextField fx:id="txtPan" promptText="10-character PAN (optional)" styleClass="approved-input"/>
    </VBox>

    <!-- Row 2: Contact Person (33%), Phone (33%) & Email (34%) -->
    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
     <Label text="Contact Person" styleClass="field-label"/>
     <TextField fx:id="txtContact" promptText="Primary accounts / dispatch contact" styleClass="approved-input"/>
    </VBox>
    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.columnSpan="2">
     <Label text="Phone" styleClass="field-label"/>
     <TextField fx:id="txtPhone" promptText="Mobile or landline number" styleClass="approved-input"/>
    </VBox>
    <VBox spacing="4" GridPane.columnIndex="4" GridPane.rowIndex="2" GridPane.columnSpan="2">
     <Label text="Email" styleClass="field-label"/>
     <TextField fx:id="txtEmail" promptText="accounts@supplier.com" styleClass="approved-input"/>
    </VBox>

    <!-- Row 3: Notes (Full Width, Bounded Crisp Height) -->
    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="6">
     <Label text="Notes" styleClass="field-label"/>
     <TextArea fx:id="txtNotes" prefRowCount="2" minHeight="62" prefHeight="68" maxHeight="84" wrapText="true" promptText="Payment terms, reconciliation remarks, or vendor notes..."/>
    </VBox>
   </GridPane>

   <!-- Bottom Action Dock -->
   <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="inspection-action-dock">
    <Button text="Cancel" onAction="#cancelEdit" minWidth="-Infinity" styleClass="approved-button,approved-danger-ghost-button"/>
    <Button fx:id="btnSave" text="Save Recon Supplier" onAction="#saveSupplier" minWidth="-Infinity" styleClass="approved-button,approved-primary-button"/>
   </HBox>
  </VBox>
 </HBox>
</VBox>
