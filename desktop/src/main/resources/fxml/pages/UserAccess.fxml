<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserAccessController" spacing="12" styleClass="user-access-page,approved-ui,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="ua-premium-header,erp-page-identity-header"><StackPane fx:id="userAccessPageIcon" styleClass="erp-page-header-icon"/><VBox spacing="2"><Label text="User Access &amp; Permissions" styleClass="screen-title"/><Label text="Manage users, account security and access from one administration workspace" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Registration Approvals" onAction="#registrationApprovals" styleClass="approved-button,approved-secondary-button"/><Button text="Manage Roles" onAction="#manageRoles" styleClass="approved-button,approved-secondary-button"/><Button text="Permission Matrix" onAction="#showPermissionMatrix" styleClass="primary-button"/><Button text="Add New User" onAction="#addUser" styleClass="primary-button,user-access-add-user"/></HBox>
 <TextField fx:id="txtSearch" managed="false"/>
 <HBox spacing="10" styleClass="erp-kpi-section">
  <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,user-kpi,user-kpi-purple,kpi-purple">
   <StackPane fx:id="iconTotalUsers" styleClass="standard-kpi-icon,approved-kpi-icon"/>
   <VBox spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT">
     <Label text="Total Users" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption"/>
     <Region HBox.hgrow="ALWAYS"/>
     <Label text="Accounts" styleClass="metric-trend-pill,trend-neutral"/>
    </HBox>
    <Label fx:id="lblTotal" text="0" styleClass="metric-value,approved-kpi-value"/>
    <Label text="Configured accounts" wrapText="true" styleClass="metric-note,approved-kpi-note"/>
   </VBox>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,user-kpi,user-kpi-green,kpi-green">
   <StackPane fx:id="iconActiveUsers" styleClass="standard-kpi-icon,approved-kpi-icon"/>
   <VBox spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT">
     <Label text="Active Users" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption"/>
     <Region HBox.hgrow="ALWAYS"/>
     <Label text="Active" styleClass="metric-trend-pill,trend-positive"/>
    </HBox>
    <Label fx:id="lblActive" text="0" styleClass="metric-value,approved-kpi-value"/>
    <Label text="Currently active" wrapText="true" styleClass="metric-note,approved-kpi-note"/>
   </VBox>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,user-kpi,user-kpi-blue,kpi-blue">
   <StackPane fx:id="iconRoles" styleClass="standard-kpi-icon,approved-kpi-icon"/>
   <VBox spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT">
     <Label text="Roles" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption"/>
     <Region HBox.hgrow="ALWAYS"/>
     <Label text="Access" styleClass="metric-trend-pill,trend-info"/>
    </HBox>
    <Label fx:id="lblRoles" text="0" styleClass="metric-value,approved-kpi-value"/>
    <Label text="Assigned permissions" wrapText="true" styleClass="metric-note,approved-kpi-note"/>
   </VBox>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,user-kpi,user-kpi-red,kpi-red">
   <StackPane fx:id="iconLocked" styleClass="standard-kpi-icon,approved-kpi-icon"/>
   <VBox spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT">
     <Label text="Locked Accounts" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption"/>
     <Region HBox.hgrow="ALWAYS"/>
     <Label text="Security" styleClass="metric-trend-pill,trend-negative"/>
    </HBox>
    <Label fx:id="lblLocked" text="0" styleClass="metric-value,approved-kpi-value"/>
    <Label text="Failed login locks" wrapText="true" styleClass="metric-note,approved-kpi-note"/>
   </VBox>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,user-kpi,user-kpi-cyan,kpi-cyan">
   <StackPane fx:id="iconLogins" styleClass="standard-kpi-icon,approved-kpi-icon"/>
   <VBox spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT">
     <Label text="Login Activity" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption"/>
     <Region HBox.hgrow="ALWAYS"/>
     <Label text="Today" styleClass="metric-trend-pill,trend-neutral"/>
    </HBox>
    <Label fx:id="lblLogins" text="0" styleClass="metric-value,approved-kpi-value"/>
    <Label text="Active sessions" wrapText="true" styleClass="metric-note,approved-kpi-note"/>
   </VBox>
  </HBox>
 </HBox>
 <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="user-access-card,ua-full-card"><HBox alignment="CENTER_LEFT"><VBox><Label text="User Management" styleClass="section-title"/><Label text="Search, filter and manage ERP users" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbRole" promptText="All Roles" prefWidth="180" styleClass="approved-input"/><ComboBox fx:id="cmbStatus" prefWidth="160" styleClass="approved-input"/><ComboBox fx:id="cmbBranch" promptText="All Branches" prefWidth="180" styleClass="approved-input"/><Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/></HBox>
 <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="user-access-user-table,approved-table,erp-table-profile-administration"><columns><TableColumn fx:id="colUser" text="User"/><TableColumn fx:id="colEmail" text="Email / Username"/><TableColumn fx:id="colPhone" text="Phone Number"/><TableColumn fx:id="colRole" text="Role"/><TableColumn fx:id="colDepartment" text="Department"/><TableColumn fx:id="colAccess" text="Access"/><TableColumn fx:id="colBranch" text="Branch"/><TableColumn fx:id="colStatus" text="Status"/><TableColumn fx:id="colLastLogin" text="Last Login"/><TableColumn fx:id="colMfa" text="MFA"/><TableColumn fx:id="colActions" text="Actions" sortable="false" resizable="false"/></columns></TableView>
 <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Edit Selected" onAction="#editSelected" styleClass="approved-button,approved-secondary-button"/><Button text="Reset Password" onAction="#resetSelected" styleClass="approved-button,approved-secondary-button"/><Button text="Add New User" onAction="#addUser" styleClass="primary-button"/></HBox></VBox>
 <!-- hidden compatibility controls: roles/permissions now live on separate full pages -->
 <TabPane fx:id="accessTabs" visible="false" managed="false"><tabs><Tab fx:id="tabRoles"/><Tab fx:id="tabPermissions"/></tabs></TabPane>
 <ComboBox fx:id="cmbPermissionRole" visible="false" managed="false"/><Label fx:id="lblRoleHint" visible="false" managed="false"/>
 <TableView fx:id="roleTable" styleClass="erp-table-profile-administration" visible="false" managed="false"><columns><TableColumn fx:id="colRoleName" text="Role"/><TableColumn fx:id="colRoleDescription" text="Description"/><TableColumn fx:id="colRoleUsers" text="Users"/><TableColumn fx:id="colRoleStatus" text="Status"/><TableColumn fx:id="colRoleActions" text="Actions"/></columns></TableView>
 <TableView fx:id="permissionTable" styleClass="erp-table-profile-permission" visible="false" managed="false"><columns><TableColumn fx:id="colPermissionModule" text="Module"/><TableColumn fx:id="colPermissionAction" text="Action"/><TableColumn fx:id="colPermissionDescription" text="Description"/><TableColumn fx:id="colPermissionAllowed" text="Allowed"/></columns></TableView>
</VBox>
