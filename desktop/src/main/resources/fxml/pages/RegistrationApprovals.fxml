<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.RegistrationApprovalsController" spacing="12" styleClass="approved-ui,erp-screen-root"><padding><Insets top="14" right="14" bottom="14" left="14"/></padding><HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header"><StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Registration Approvals" styleClass="screen-title"/><Label text="Approve only verified non-Admin registrations" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Back to User Access" onAction="#back" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/></HBox><HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS" minWidth="0">
    <StackPane fx:id="kpiPendingIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
    <VBox spacing="3" HBox.hgrow="ALWAYS" minWidth="0">
      <HBox alignment="CENTER_LEFT"><Label text="Pending Approval" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Review" styleClass="metric-trend-pill,trend-warning"/></HBox>
      <Label fx:id="lblPending" text="0" styleClass="metric-value"/>
    </VBox>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS" minWidth="0">
    <StackPane fx:id="kpiVerifiedIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
    <VBox spacing="3" HBox.hgrow="ALWAYS" minWidth="0">
      <HBox alignment="CENTER_LEFT"><Label text="Identity + MFA Verified" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Verified" styleClass="metric-trend-pill,trend-positive"/></HBox>
      <Label fx:id="lblVerified" text="0" styleClass="metric-value"/>
    </VBox>
  </HBox>
</HBox><TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-administration"><columns><TableColumn fx:id="colUser" text="User"/><TableColumn fx:id="colEmail" text="Email"/><TableColumn fx:id="colRole" text="Requested Role"/><TableColumn fx:id="colEmailVerified" text="Email"/><TableColumn fx:id="colMfa" text="Authenticator"/><TableColumn fx:id="colRequested" text="Requested"/><TableColumn fx:id="colStatus" text="Status"/></columns></TableView><HBox alignment="CENTER_RIGHT" spacing="8"><Label text="Assign final role" styleClass="field-caption"/><ComboBox fx:id="cmbRole" prefWidth="220" styleClass="approved-input"/><Button fx:id="btnReject" text="Reject" onAction="#reject" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnApprove" text="Approve User" onAction="#approve" styleClass="primary-button"/></HBox><Label fx:id="lblMessage" wrapText="true" styleClass="auth-message"/></VBox>