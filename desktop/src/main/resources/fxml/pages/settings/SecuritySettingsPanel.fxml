<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelSecurity" spacing="16" maxWidth="Infinity" styleClass="settings-card,security-settings-panel">
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <StackPane fx:id="securityHeaderIcon" styleClass="settings-section-icon"/>
        <VBox spacing="3">
            <Label text="Security, Session &amp; System Integration" styleClass="settings-section-title"/>
            <Label text="Administrator-controlled inactivity policy, multi-number WhatsApp engine, server health telemetry, and document numbering authority." wrapText="true" styleClass="settings-section-description"/>
        </VBox>
    </HBox>
    <Separator/>

    <!-- Cloud Server Health & Telemetry (Oracle Cloud OCI) -->
    <VBox spacing="10" styleClass="workspace-section,settings-subcard">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Cloud Server Health &amp; Telemetry (Oracle Cloud OCI)" styleClass="settings-subsection-title"/>
                    <Label fx:id="lblTelemetryTargetBadge" text="[ PROD - 130.210.35.1 ]" styleClass="telemetry-target-badge"/>
                    <Label fx:id="lblTelemetryStatusBadge" text="🟢 NORMAL &amp; HEALTHY" styleClass="telemetry-badge-healthy"/>
                </HBox>
                <Label text="Live RAM memory, disk volume headroom, and automated storage guardian status from the cloud server." styleClass="settings-help-text"/>
            </VBox>
            <Button fx:id="btnRefreshTelemetry" text="Refresh Live Telemetry" onAction="#refreshCloudTelemetry" styleClass="settings-action-button,settings-secondary-button"/>
        </HBox>
        <GridPane hgap="24" vgap="12" styleClass="workspace-metric-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <!-- Left: Disk Storage -->
            <VBox spacing="6" GridPane.columnIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Root Disk Storage" styleClass="settings-form-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTelemetryDiskUsage" text="0% Used" styleClass="workspace-metric-subvalue"/>
                </HBox>
                <ProgressBar fx:id="pbTelemetryDisk" progress="0.0" maxWidth="Infinity" prefHeight="12" styleClass="telemetry-progress,telemetry-bar-healthy"/>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="lblTelemetryDiskTotal" text="Allocated: —" styleClass="page-subtitle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTelemetryDiskFree" text="Free: —" styleClass="page-subtitle"/>
                    <Label fx:id="lblTelemetryDiskUsed" text="Used: —" styleClass="page-subtitle"/>
                </HBox>
            </VBox>
            <!-- Right: Memory / RAM -->
            <VBox spacing="6" GridPane.columnIndex="1">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="RAM Memory Utilization" styleClass="settings-form-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTelemetryRamUsage" text="0% Used" styleClass="workspace-metric-subvalue"/>
                </HBox>
                <ProgressBar fx:id="pbTelemetryRam" progress="0.0" maxWidth="Infinity" prefHeight="12" styleClass="telemetry-progress,telemetry-bar-healthy"/>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="lblTelemetryRamTotal" text="Shape Total: —" styleClass="page-subtitle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTelemetryRamAvailable" text="Available: —" styleClass="page-subtitle"/>
                    <Label fx:id="lblTelemetryRamActive" text="Active: —" styleClass="page-subtitle"/>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>
    <Separator/>

    <!-- Session & Inactivity Policy -->
    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <VBox spacing="5">
            <Label text="Session Timeout (minutes)" styleClass="settings-form-label,field-label-time"/>
            <TextField fx:id="txtSessionTimeoutMinutes" promptText="10" maxWidth="Infinity" styleClass="approved-input"/>
            <Label text="Allowed: 5–120 minutes" styleClass="muted-text"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1">
            <Label text="Warning Before Logout (minutes)" styleClass="settings-form-label,field-label-reminder"/>
            <TextField fx:id="txtSessionWarningMinutes" promptText="2" maxWidth="Infinity" styleClass="approved-input"/>
            <Label text="Must be at least 1 minute and less than the timeout." styleClass="muted-text"/>
        </VBox>
    </GridPane>
    <Separator/>

    <!-- Authentication / MFA Policy -->
    <VBox spacing="7" styleClass="security-settings-subsection">
        <Label text="Authentication / MFA Policy" styleClass="settings-form-label"/>
        <ComboBox fx:id="cmbMfaPolicy" maxWidth="420" styleClass="approved-input"/>
    </VBox>
    <Separator/>

    <!-- Document Numbering & Reference Formats -->
    <VBox spacing="6" maxWidth="Infinity" styleClass="settings-information-card">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Document Numbering &amp; Reference Formats" styleClass="settings-subsection-title"/>
            <Button text="Information &amp; Guidance" onAction="#showRefFormatInfoDialog" styleClass="settings-secondary-button,approved-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Synchronize Reference Formats" onAction="#handleRefFormatSyncAction" styleClass="settings-secondary-button,approved-button"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="settings-asset-card">
            <Label text="Active Pattern:" styleClass="settings-form-label"/>
            <Label fx:id="lblActiveRefFormat" text="PREFIX / DD-MM-YYYY / XXXX (e.g., IN/01-11-2026/0001)" styleClass="settings-asset-filename"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- UI Diagnostics -->
    <VBox spacing="7" styleClass="security-settings-subsection">
        <CheckBox fx:id="chkUiDiagnostics" text="Enable UI Diagnostics"/>
    </VBox>
</VBox>
