<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelModules" visible="false" managed="false" maxWidth="Infinity" spacing="16" styleClass="settings-card,settings-card-tall-compact">

    <VBox spacing="3">
        <Label text="Module Activation &amp; Feature Control" styleClass="settings-section-title"/>
        <Label text="Control ERP business modules, statutory engines, and smart operational automations. Deactivated modules are hidden from navigation and bypassed with zero overhead." wrapText="true" styleClass="settings-section-description"/>
    </VBox>

    <Separator/>

    <!-- 1. GENERAL LEDGER & ACCOUNTING -->
    <VBox spacing="8" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="General Ledger &amp; Double-Entry Accounting" styleClass="settings-form-label,bold-label"/>
                <Label text="Master Chart of Accounts, debit/credit journal vouchers, real-time Trial Balance, and Profit &amp; Loss." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
            <CheckBox fx:id="chkGlEnabled" text="Enable GL Module" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
        <HBox spacing="24" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkGlAutoPost" text="Auto-post Journal Vouchers from Sales &amp; Purchases" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkGlTrialBalance" text="Maintain Live Trial Balance" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- 2. GST & TAX COMPLIANCE -->
    <VBox spacing="8" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="GST Statutory Compliance &amp; GSTR-2B Auto-Reconciliation" styleClass="settings-form-label,bold-label"/>
                <Label text="Automated Place of Supply tax split, GSTR-1 government JSON exports, and GSTR-2B ITC fuzzy reconciliation." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
            <CheckBox fx:id="chkGstEnabled" text="Enable GST Engine" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
        <HBox spacing="24" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkGstAuto2bMatch" text="Auto-Reconcile GSTR-2B Purchases" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkGstPosGating" text="Strict Place of Supply Gating" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkTdsEnabled" text="TDS / TCS Withholding (Sec 194Q &amp; 206C)" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- 3. SMART OPERATIONAL AUTOMATIONS -->
    <VBox spacing="8" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Smart Operational Automations Suite" styleClass="settings-form-label,bold-label"/>
                <Label text="Automate purchase bill verification against PO/GRN, dynamic stock replenishment, and smart FIFO payment matching." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
        </HBox>
        <GridPane hgap="16" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <CheckBox fx:id="chkThreeWayMatch" text="Smart 3-Way Purchase Matching (PO vs GRN vs Bill)" styleClass="approved-checkbox,ios-toggle-switch"/>
                <CheckBox fx:id="chkAutoDraftDebitNote" text="Auto-generate draft debit notes for short shipments" styleClass="approved-checkbox,ios-toggle-switch"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <CheckBox fx:id="chkStockAutoReorder" text="Dynamic Safety Stock &amp; Auto-Reorder Alerts" styleClass="approved-checkbox,ios-toggle-switch"/>
                <CheckBox fx:id="chkCreditHardStop" text="Customer Overdue Credit Hard Stop (Block Invoicing)" styleClass="approved-checkbox,ios-toggle-switch"/>
            </VBox>
        </GridPane>
    </VBox>

    <Separator/>

    <!-- 4. EXECUTIVE 8:00 PM BRIEFING -->
    <VBox spacing="8" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Executive 8:00 PM Daily Briefing" styleClass="settings-form-label,bold-label"/>
                <Label text="Daily evening summary of sales, customer collections, vendor payments, bank balances, and overdue accounts." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
            <CheckBox fx:id="chkDailyBriefing" text="Enable Daily Briefing" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
        <HBox spacing="24" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkBriefingWa" text="WhatsApp Channel" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkBriefingEmail" text="Email Channel" styleClass="approved-checkbox,ios-toggle-switch"/>
            <Label text="Mobile No:" styleClass="settings-form-label"/>
            <TextField fx:id="txtBriefingPhone" promptText="+91 98765 43210" styleClass="approved-input"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- 5. WAREHOUSE & BATCH REGISTRY -->
    <VBox spacing="8" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Multi-Warehouse, Batch/Expiry (FEFO) &amp; Serial Registry" styleClass="settings-form-label,bold-label"/>
                <Label text="Track stock across multiple storage depots, enforce First-Expired First-Out dispatches, and track equipment serial warranties." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
            <CheckBox fx:id="chkBatchSerialTracking" text="Enable Batch/Serial Tracking" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- 6. SMART OVERDUE COLLECTIONS & STATEMENT DISPATCH (OPTION 1) -->
    <VBox spacing="10" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Smart Overdue Collections &amp; Statement Dispatch" styleClass="settings-form-label,bold-label"/>
                <Label text="Send real WhatsApp &amp; Email payment reminders with auto-generated Branded Party Aging Statement PDFs directly from Aging Analysis." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
            <CheckBox fx:id="chkCollectionsEnabled" text="Enable Collections Dispatch" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkCollectionsWhatsapp" text="WhatsApp Dispatch (WAHA)" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkCollectionsEmail" text="Email Dispatch (SMTP)" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkCollectionsAttachPdf" text="Auto-Attach Branded Statement PDF" styleClass="approved-checkbox,ios-toggle-switch"/>
            <Label text="Cooldown Guard:" minWidth="-Infinity" styleClass="settings-form-label"/>
            <ComboBox fx:id="cmbCollectionsCooldownHours" prefWidth="128" styleClass="approved-input"/>
        </HBox>
        <VBox spacing="4" styleClass="settings-impact-box">
            <HBox spacing="8" alignment="TOP_LEFT" styleClass="settings-impact-row">
                <Label text="WHEN ON" minWidth="-Infinity" styleClass="settings-impact-tag-on"/>
                <Label text="Aging Analysis enables 1-click &amp; bulk WhatsApp/Email dispatch with auto-generated Party Statement PDF, severity templates (30/60/90+ days), Last Reminded badge, and cooldown spam guard. All dispatches log to Communication Center." wrapText="true" HBox.hgrow="ALWAYS" styleClass="settings-impact-text"/>
            </HBox>
            <HBox spacing="8" alignment="TOP_LEFT" styleClass="settings-impact-row">
                <Label text="WHEN OFF" minWidth="-Infinity" styleClass="settings-impact-tag-off"/>
                <Label text="External WhatsApp &amp; Email collection dispatch is bypassed immediately (zero messages sent to parties); Aging reminders fall back strictly to internal Reminder Center notes. All past Communication Center history remains preserved." wrapText="true" HBox.hgrow="ALWAYS" styleClass="settings-impact-text"/>
            </HBox>
            <HBox spacing="8" alignment="TOP_LEFT" styleClass="settings-impact-row">
                <Label text="IMPACTED" minWidth="-Infinity" styleClass="settings-impact-tag-scope"/>
                <Label text="AR / AP Aging Analysis • Customer 360 • Communication Center • Reminder Center • Email (SMTP) &amp; WhatsApp (WAHA) Channels" wrapText="true" HBox.hgrow="ALWAYS" styleClass="settings-impact-text"/>
            </HBox>
        </VBox>
    </VBox>

    <Separator/>

    <!-- 7. BANK STATEMENT SMART NARRATION AUTO-RULES ENGINE (OPTION 2) -->
    <VBox spacing="10" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Bank Statement Smart Narration Auto-Rules Engine" styleClass="settings-form-label,bold-label"/>
                <Label text="Learn recurring bank narrations (rent, UPI handles, payment gateways, bank charges) to auto-suggest or auto-route future statement imports." wrapText="true" styleClass="settings-field-hint"/>
            </VBox>
            <CheckBox fx:id="chkBankRulesEnabled" text="Enable Smart Bank Rules" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkBankRulesSuggestOnImport" text="Auto-Suggest Matches on Import" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkBankRulesAutoApplyOnImport" text="Allow Auto-Apply Rules on Import" styleClass="approved-checkbox,ios-toggle-switch"/>
            <CheckBox fx:id="chkBankRulesPromptSave" text="Show &quot;Remember Rule&quot; in Action Dialogs" styleClass="approved-checkbox,ios-toggle-switch"/>
        </HBox>
        <VBox spacing="4" styleClass="settings-impact-box">
            <HBox spacing="8" alignment="TOP_LEFT" styleClass="settings-impact-row">
                <Label text="WHEN ON" minWidth="-Infinity" styleClass="settings-impact-tag-on"/>
                <Label text="Bank Statement shows Reconciliation Rules manager, Run Rules action, and &quot;Remember Rule&quot; inside Move to Expense / Bank Entry / Ignore modals. Future statement imports evaluate saved rules with full audit trace." wrapText="true" HBox.hgrow="ALWAYS" styleClass="settings-impact-text"/>
            </HBox>
            <HBox spacing="8" alignment="TOP_LEFT" styleClass="settings-impact-row">
                <Label text="WHEN OFF" minWidth="-Infinity" styleClass="settings-impact-tag-off"/>
                <Label text="Hides Rules UI in Bank Statement and skips all rule evaluation during CSV/PDF import (100% classic manual reconciliation, zero overhead). Existing saved rules and reconciled entries stay safely preserved in PostgreSQL." wrapText="true" HBox.hgrow="ALWAYS" styleClass="settings-impact-text"/>
            </HBox>
            <HBox spacing="8" alignment="TOP_LEFT" styleClass="settings-impact-row">
                <Label text="IMPACTED" minWidth="-Infinity" styleClass="settings-impact-tag-scope"/>
                <Label text="Bank Statement • Move to Expense / Bank Entry / Ignore Dialogs • Bank Expense Ledger • Server Bank Reconciliation Import Pipeline" wrapText="true" HBox.hgrow="ALWAYS" styleClass="settings-impact-text"/>
            </HBox>
        </VBox>
    </VBox>

</VBox>
