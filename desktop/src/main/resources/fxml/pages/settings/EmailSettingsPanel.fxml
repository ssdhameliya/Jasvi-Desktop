<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelEmail" visible="false" managed="false" maxWidth="Infinity" spacing="14" styleClass="settings-card,settings-email-compact">
    <VBox spacing="3">
        <Label text="Email &amp; Communication Preferences" styleClass="settings-section-title"/>
        <Label text="SMTP delivery configuration, corporate email signature, and document message templates" wrapText="true" styleClass="settings-section-description"/>
    </VBox>

    <VBox spacing="12" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Email Account (SMTP)" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnEmailSecurityInfo" text="Information &amp; Guidance" onAction="#showEmailSecurityInfo" styleClass="secondary-button"/>
            <Label text="Configuration is stored securely in your workspace" styleClass="page-subtitle"/>
        </HBox>
        <GridPane hgap="18" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <VBox spacing="7" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Sending Email Address" styleClass="settings-form-label"/>
                <TextField fx:id="txtSmtpEmail" promptText="name@example.com" styleClass="approved-input"/>
            </VBox>
            <VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Email App Password" styleClass="settings-form-label"/>
                <PasswordField fx:id="txtSmtpPassword" promptText="Provider app password" maxWidth="Infinity" styleClass="approved-input"/>
            </VBox>
            <VBox spacing="7" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="SMTP Host" styleClass="settings-form-label"/>
                <TextField fx:id="txtSmtpHost" promptText="Automatic, smtp.mail.yahoo.com, smtp.gmail.com..." styleClass="approved-input"/>
            </VBox>
            <VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="SMTP Port" styleClass="settings-form-label"/>
                <TextField fx:id="txtSmtpPort" promptText="587" styleClass="approved-input"/>
            </VBox>
        </GridPane>
    </VBox>

    <!-- Feature Flag 1: Department & Activity Sender Routing -->
    <VBox spacing="10" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Department &amp; Activity Email Routing" styleClass="section-title"/>
                <Label text="Toggle between single master email and dedicated department accounts with separate passcodes" styleClass="page-subtitle"/>
            </VBox>
            <ToggleButton fx:id="tglActivityRouting" text="Activity Routing: OFF" styleClass="apple-toggle-switch,ios-toggle-switch"/>
        </HBox>

        <VBox fx:id="boxActivityRoutingSection" spacing="12" visible="false" managed="false">
            <VBox spacing="8">
                <HBox fx:id="departmentTabStrip" alignment="CENTER_LEFT" spacing="6" styleClass="settings-category-strip,approved-card,approved-surface">
                    <Button fx:id="btnDeptSales" text="Sales &amp; Invoices" onAction="#selectDeptSales" styleClass="settings-tab-btn,erp-semantic-blue,settings-tab-selected">
                        <graphic>
                            <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" styleClass="settings-button-icon"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnDeptQuotes" text="Quotations &amp; RFQ" onAction="#selectDeptQuotes" styleClass="settings-tab-btn,erp-semantic-purple">
                        <graphic>
                            <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" styleClass="settings-button-icon"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnDeptPurchases" text="Purchases" onAction="#selectDeptPurchases" styleClass="settings-tab-btn,erp-semantic-cyan">
                        <graphic>
                            <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" styleClass="settings-button-icon"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnDeptReturns" text="Returns" onAction="#selectDeptReturns" styleClass="settings-tab-btn,erp-semantic-orange">
                        <graphic>
                            <SVGPath content="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" styleClass="settings-button-icon"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnDeptAccounts" text="Accounts" onAction="#selectDeptAccounts" styleClass="settings-tab-btn,erp-semantic-green">
                        <graphic>
                            <SVGPath content="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z" styleClass="settings-button-icon"/>
                        </graphic>
                    </Button>
                    <ComboBox fx:id="cmbActivityProfileSelect" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnTestActivityProfile" text="Test Connection" onAction="#testActivityProfileEmail" styleClass="secondary-button"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="settings-asset-card">
                    <Label fx:id="lblActiveDepartmentBadge" text="Configuring: Sales &amp; Invoices" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="chkEnableDedicatedProfile" text="Use Dedicated Account for this Department" styleClass="approved-check"/>
                </HBox>
            </VBox>

            <GridPane hgap="18" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Sender Display Name" styleClass="settings-form-label"/>
                    <TextField fx:id="txtProfileSenderName" promptText="Jasvi Industries - Sales" styleClass="approved-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Department Email Address" styleClass="settings-form-label"/>
                    <TextField fx:id="txtProfileSenderEmail" promptText="sales@jasviindustries.in" styleClass="approved-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Email App Password / Passcode" styleClass="settings-form-label"/>
                    <PasswordField fx:id="txtProfileSenderPassword" promptText="Dedicated app password" styleClass="approved-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="SMTP Host &amp; Port" styleClass="settings-form-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="txtProfileSenderHost" promptText="smtp.gmail.com" styleClass="approved-input" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtProfileSenderPort" promptText="587" prefWidth="75" styleClass="approved-input"/>
                    </HBox>
                </VBox>
            </GridPane>

            <VBox spacing="6">
                <Label text="Department Custom Signature (Optional)" styleClass="settings-form-label"/>
                <TextArea fx:id="txtProfileCustomSignature" prefRowCount="3" minHeight="70" promptText="Leave blank to inherit Company Email Signature..." wrapText="true" styleClass="approved-input"/>
            </VBox>
        </VBox>
    </VBox>

    <VBox spacing="10" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Company Email Signature" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Appended automatically whenever {Signature} token is present in message templates" styleClass="page-subtitle"/>
        </HBox>
        <VBox spacing="6">
            <Label text="Signature Block" styleClass="settings-form-label"/>
            <TextArea fx:id="txtEmailSignature" prefRowCount="5" minHeight="95" promptText="Regards,&#10;Company Name&#10;Phone: +91 ... | Email: info@..." wrapText="true" styleClass="approved-input"/>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Signature / Stamp Image (Optional)" styleClass="settings-form-label"/>
                <Label fx:id="lblSignatureImageStatus" text="No signature image attached" styleClass="page-subtitle"/>
            </VBox>
            <StackPane minWidth="64" minHeight="36" prefWidth="90" prefHeight="40" maxHeight="45" styleClass="settings-image-preview">
                <ImageView fx:id="imgSignaturePreview" preserveRatio="true" smooth="true" fitHeight="36" fitWidth="80"/>
            </StackPane>
            <Button fx:id="btnBrowseSignatureImage" text="Browse Image" onAction="#browseSignatureImage" styleClass="secondary-button"/>
            <Button fx:id="btnPreviewSignatureImage" text="Preview Image" onAction="#previewSignatureImage" styleClass="secondary-button"/>
            <Button fx:id="btnClearSignatureImage" text="Clear Image" onAction="#clearSignatureImage" styleClass="secondary-button"/>
                </HBox>
        <HBox alignment="CENTER_LEFT" spacing="24" styleClass="settings-asset-card">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ToggleButton fx:id="tglAttachSignatureEmail" text="Attach to Email: OFF" styleClass="apple-toggle-switch,ios-toggle-switch"/>
                <Label text="Include signature stamp image on email delivery" styleClass="muted-text"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ToggleButton fx:id="tglAttachSignatureWhatsapp" text="Attach to WhatsApp: OFF" styleClass="apple-toggle-switch,ios-toggle-switch"/>
                <Label text="Include signature stamp image on WhatsApp dispatch" styleClass="muted-text"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Feature Flag 2: Bank Reconciliation Payment Receipts -->
    <VBox spacing="8" styleClass="settings-subcard">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Bank Statement Match Payment Receipts" styleClass="section-title"/>
                <Label text="Prompt to send payment receipt with dual bank details and Live Status tracking upon transaction match" styleClass="page-subtitle"/>
            </VBox>
            <ToggleButton fx:id="tglPaymentConfirmationEmail" text="Payment Receipts: ON" styleClass="apple-toggle-switch,ios-toggle-switch"/>
        </HBox>
    </VBox>
</VBox>
