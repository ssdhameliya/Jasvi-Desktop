<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="panelShortcuts" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12" minHeight="0" maxHeight="Infinity"
      styleClass="approved-ui,approved-screen,erp-screen-root,dse-shortcut-v3-root,shortcut-manager-root">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-page-header,approved-section-header,erp-page-identity-header,shortcut-manager-header">
    <StackPane fx:id="shortcutHeaderIcon" minWidth="46" prefWidth="46" minHeight="46" prefHeight="46"
               styleClass="erp-page-header-icon,shortcut-manager-header-icon"/>
    <VBox spacing="3" HBox.hgrow="ALWAYS">
      <Label text="Keyboard Shortcuts" styleClass="approved-page-title,page-title,shortcut-manager-title"/>
      <Label text="Manage application actions, quick-create commands and navigation shortcuts."
             styleClass="approved-page-subtitle,page-subtitle,shortcut-manager-subtitle"/>
    </VBox>
    <Button text="Import" onAction="#importShortcuts" styleClass="approved-button,approved-secondary-button,approved-sky-button,erp-button-sky"/>
    <Button text="Export" onAction="#exportShortcuts" styleClass="approved-button,approved-secondary-button,approved-teal-button,erp-button-teal"/>
    <Button text="Reset Defaults" onAction="#resetAllShortcuts" styleClass="approved-button,approved-secondary-button,approved-orange-button,erp-button-orange"/>
  </HBox>

  <HBox spacing="10" styleClass="standard-kpi-row,shortcut-kpi-row,erp-kpi-section">
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-blue,approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiTotalIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
      <VBox spacing="3" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT"><Label text="Available Actions" styleClass="metric-label,approved-metric-note"/><Region HBox.hgrow="ALWAYS"/><Label text="Total" styleClass="metric-trend-pill,trend-neutral"/></HBox>
        <Label fx:id="lblShortcutTotal" text="0" styleClass="metric-value,approved-kpi-value"/>
        <Label text="Three user-facing groups" styleClass="metric-note"/>
      </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-green,approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiCustomIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
      <VBox spacing="3" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT"><Label text="Custom Assignments" styleClass="metric-label,approved-metric-note"/><Region HBox.hgrow="ALWAYS"/><Label text="Custom" styleClass="metric-trend-pill,trend-positive"/></HBox>
        <Label fx:id="lblShortcutCustom" text="0" styleClass="metric-value,approved-kpi-value"/>
        <Label text="Changed from defaults" styleClass="metric-note"/>
      </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-red,approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiConflictIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
      <VBox spacing="3" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT"><Label text="Conflicts" styleClass="metric-label,approved-metric-note"/><Region HBox.hgrow="ALWAYS"/><Label text="Zero Required" styleClass="metric-trend-pill,trend-negative"/></HBox>
        <Label fx:id="lblShortcutConflicts" text="0" styleClass="metric-value,approved-kpi-value"/>
        <Label text="Must be zero to save" styleClass="metric-note"/>
      </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-purple,approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiCategoryIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
      <VBox spacing="3" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT"><Label text="Groups" styleClass="metric-label,approved-metric-note"/><Region HBox.hgrow="ALWAYS"/><Label text="Categories" styleClass="metric-trend-pill,trend-info"/></HBox>
        <Label fx:id="lblShortcutCategories" text="3" styleClass="metric-value,approved-kpi-value"/>
        <Label text="Application • Quick Create • Navigation" styleClass="metric-note"/>
      </VBox>
    </HBox>
  </HBox>

  <HBox alignment="CENTER_LEFT" spacing="10" styleClass="approved-filter-bar,shortcut-group-bar">
    <TextField fx:id="txtShortcutSearch" promptText="Search action, key or scope..." prefWidth="300"
               styleClass="approved-input,register-header-search-input"/>
    <Button fx:id="btnShortcutApplication" text="Application Actions" onAction="#showShortcutApplicationActions"
            styleClass="shortcut-group-button"/>
    <Button fx:id="btnShortcutQuickCreate" text="Quick Create" onAction="#showShortcutQuickCreate"
            styleClass="shortcut-group-button"/>
    <Button fx:id="btnShortcutNavigation" text="Navigation" onAction="#showShortcutNavigation"
            styleClass="shortcut-group-button"/>
    <Separator orientation="VERTICAL" maxHeight="20"/>
    <HBox spacing="4" alignment="CENTER_LEFT" styleClass="shortcut-status-segmented-bar">
      <Button fx:id="btnStatusAll" text="All" onAction="#filterShortcutsAll"
              styleClass="shortcut-status-pill,shortcut-status-active"/>
      <Button fx:id="btnStatusActive" text="Active / ON" onAction="#filterShortcutsActive"
              styleClass="shortcut-status-pill"/>
      <Button fx:id="btnStatusDisabled" text="Disabled / OFF" onAction="#filterShortcutsDisabled"
              styleClass="shortcut-status-pill"/>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="lblShortcutValidation" text="No shortcut conflicts detected." styleClass="shortcut-validation"/>
  </HBox>

  <!-- Full-Width Single-Pane Shortcuts Workspace (Zero Cramped Side Drawer) -->
  <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="approved-card,approved-surface,shortcut-list-card">
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="shortcut-table-header-row">
      <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
      <Label text="ACTION &amp; DESCRIPTION" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="shortcut-col-header"/>
      <Label text="SCOPE" prefWidth="140" alignment="CENTER" styleClass="shortcut-col-header"/>
      <Label text="SHORTCUT KEY" prefWidth="160" alignment="CENTER" styleClass="shortcut-col-header"/>
      <Label text="ON / OFF" prefWidth="110" alignment="CENTER" styleClass="shortcut-col-header"/>
      <Label text="RESET" prefWidth="60" alignment="CENTER" styleClass="shortcut-col-header"/>
    </HBox>
    <ListView fx:id="lstShortcutActions" VBox.vgrow="ALWAYS" styleClass="shortcut-action-list"/>
  </VBox>

  <!-- Hidden drawer container preserving @FXML injections and automated contract invariance -->
  <VBox fx:id="shortcutDrawer" visible="false" managed="false" minHeight="0" prefHeight="0" maxHeight="0">
    <StackPane fx:id="shortcutDrawerIcon"/>
    <Label fx:id="lblShortcutDrawerTitle"/>
    <ComboBox fx:id="cmbShortcutAction"/>
    <TextField fx:id="txtShortcutKeys"/>
    <ComboBox fx:id="cmbShortcutScope"/>
    <Label fx:id="lblShortcutScopeHint"/>
    <TextArea fx:id="txtShortcutDescription"/>
    <ToggleButton fx:id="chkShortcutActive"/>
    <CheckBox fx:id="chkShortcutAllowTextInput"/>
    <CheckBox fx:id="chkShortcutRequireSelection"/>
    <VBox fx:id="shortcutConflictBox">
      <Label fx:id="lblShortcutConflict"/>
    </VBox>
    <Button text="Disable" onAction="#disableSelectedShortcut"/>
    <Button text="Reset" onAction="#resetSelectedShortcut"/>
    <Button text="Save Shortcut" onAction="#saveSelectedShortcut"/>
  </VBox>
</VBox>
