<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelPayment" visible="false" managed="false" maxWidth="Infinity" styleClass="settings-card,settings-card-tall-compact">

                            <VBox spacing="3">

                                <Label text="Payment &amp; Bank" styleClass="settings-section-title"/>

                                <Label text="Details used on invoices, payment messages and UPI/GPay links" wrapText="true" styleClass="settings-section-description"/>

                            </VBox>

                            <GridPane hgap="12" vgap="8">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="33.334" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">

                                    <Label text="UPI ID" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtUpiId" promptText="company@bank" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">

                                    <Label text="Account Holder Name" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtAccountHolder" promptText="Enter account holder" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">

                                    <Label text="Bank Name" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtBankName" promptText="Enter bank name" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">

                                    <Label text="Account Number" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtAccountNumber" promptText="Enter account number" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">

                                    <Label text="IFSC Code" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtIfsc" promptText="Example: IDFB0010123" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">

                                    <Label text="Branch" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtBranch" promptText="Enter branch name" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">

                                    <Label text="Account Type" styleClass="settings-form-label"/>

                                    <ComboBox fx:id="cmbAccountType" promptText="Select account type" maxWidth="Infinity" styleClass="approved-input"/>

                                    <Label text="Values come from Master Data → Account Type" wrapText="true" styleClass="settings-help-text"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">

                                    <Label text="Round-off Tolerance (₹)" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtBankMatchRoundingTolerance" promptText="1.00" styleClass="approved-input"/>

                                    <Label text="Auto-reconciliation tolerance (₹0.00 to ₹5.00)" wrapText="true" styleClass="settings-help-text"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="2" alignment="CENTER_LEFT">

                                    <Label text="Bank Reconciliation Match" styleClass="settings-form-label"/>

                                    <Label text="Allows closing residual difference up to tolerance as an explicit round-off adjustment." wrapText="true" styleClass="settings-information-text"/>

                                </VBox>

                            </GridPane>

                            <Separator/>

                            <!-- PAYMENT QR -->

                            <VBox spacing="7">

                                <Label text="UPI Payment QR Code" styleClass="settings-subsection-title"/>

                                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="settings-asset-card" maxWidth="Infinity">

                                    <StackPane fx:id="paymentQrPreview" minWidth="135" prefWidth="135" maxWidth="135" minHeight="135" prefHeight="135" maxHeight="135" styleClass="settings-image-preview,settings-qr-preview">

                                        <ImageView fx:id="imgPaymentQr" preserveRatio="true" smooth="true"/>

                                        <VBox fx:id="placeholderPaymentQr" alignment="CENTER" spacing="6">

                                            <SVGPath content="M2 2h6v6H2V2zm2 2v2h2V4H4zm8-2h6v6h-6V2zm2 2v2h2V4h-2zM2 12h6v6H2v-6zm2 2v2h2v-2H4zm8-2h2v2h-2v-2zm4 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm4 0h2v2h-2v-2z" styleClass="settings-placeholder-icon"/>

                                            <Label text="No QR image selected" styleClass="settings-help-text"/>

                                        </VBox>

                                    </StackPane>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">

                                        <HBox spacing="10" alignment="CENTER_LEFT">

                                            <Label text="Attached QR File:" styleClass="settings-form-label"/>

                                            <Label fx:id="lblQrFile" text="No image selected" maxWidth="Infinity" HBox.hgrow="ALWAYS" textOverrun="CENTER_ELLIPSIS" styleClass="settings-asset-filename"/>

                                        </HBox>

                                        <FlowPane hgap="8" vgap="8" prefWrapLength="500" styleClass="settings-asset-actions">

                                            <Button text="Add / Replace" onAction="#uploadPaymentQr" styleClass="settings-secondary-button,approved-button,approved-primary-button"/>

                                            <Button text="Preview" onAction="#previewPaymentQr" styleClass="settings-secondary-button,approved-button,approved-secondary-button"/>

                                            <Button text="Remove" onAction="#removePaymentQr" styleClass="settings-remove-button,approved-button,approved-danger-button"/>

                                        </FlowPane>

                                        <VBox spacing="3" styleClass="settings-information-card" maxWidth="Infinity">

                                            <Label text="How the payment QR is used" styleClass="settings-form-label"/>

                                            <Label text="Printed beside bank details on invoices, quotations and receipts with UPI payload." wrapText="true" styleClass="settings-information-text"/>

                                        </VBox>

                                    </VBox>

                                </HBox>

                            </VBox>

                        </VBox>


