<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.GeneralLedgerController" styleClass="approved-screen,erp-screen-root,recon-page">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
  <top>
    <VBox spacing="10">
      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="approved-page-header,erp-page-identity-header,approved-card">
        <StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/>
        <VBox spacing="2">
          <Label text="General Ledger &amp; Financial Accounting" styleClass="screen-title"/>
          <Label text="Double-entry journals, Chart of Accounts, Account Ledger drill-down, Trial Balance, P&amp;L &amp; Balance Sheet" wrapText="true" styleClass="screen-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblPeriodLockBadge" text="Books Open" styleClass="status-pill,status-positive"/>
        <Button fx:id="btnHealthCheck" text="GL Health Check" onAction="#openHealthCheckDialog" styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="btnCloseYear" text="Close Fiscal Year" onAction="#openCloseYearDialog" styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="btnPeriodLock" text="Period Lock" onAction="#openPeriodLockDialog" styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="btnNewJournal" text="New Journal Voucher" onAction="#openNewJournalDialog" styleClass="primary-action,approved-button,approved-primary-button"/>
        <MenuButton fx:id="btnExport" text="Export" styleClass="approved-button,approved-secondary-button">
          <items>
            <MenuItem fx:id="miExportExcel" text="Excel"  onAction="#exportStatement"/>
            <MenuItem fx:id="miExportCsv"   text="CSV"    onAction="#exportCsv"/>
            <MenuItem fx:id="miExportPdf"   text="PDF"    onAction="#exportPdfFinancialPack"/>
          </items>
        </MenuButton>
        <Button fx:id="btnRefreshLedger" text="Refresh" onAction="#refreshJournals" styleClass="approved-button,approved-secondary-button"/>
      </HBox>

      <GridPane hgap="10" vgap="0" styleClass="standard-kpi-row,erp-kpi-section,erp-kpi-single-row">
        <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-blue" GridPane.columnIndex="0">
          <StackPane fx:id="kpiAssetsIcon" styleClass="standard-kpi-icon"/>
          <VBox spacing="3" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT"><Label text="Total Assets" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Assets" styleClass="metric-trend-pill,trend-positive"/></HBox>
            <Label fx:id="kpiTotalAssets" text="₹ 0.00" styleClass="metric-value"/>
            <Label text="Bank + Debtors + Stock" wrapText="true" styleClass="metric-note"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-orange" GridPane.columnIndex="1">
          <StackPane fx:id="kpiLiabilitiesIcon" styleClass="standard-kpi-icon"/>
          <VBox spacing="3" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT"><Label text="Total Liabilities" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Due" styleClass="metric-trend-pill,trend-warning"/></HBox>
            <Label fx:id="kpiTotalLiabilities" text="₹ 0.00" styleClass="metric-value"/>
            <Label text="Payables + GST Due" wrapText="true" styleClass="metric-note"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-green" GridPane.columnIndex="2">
          <StackPane fx:id="kpiRevenueIcon" styleClass="standard-kpi-icon"/>
          <VBox spacing="3" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT"><Label text="Operating Revenue" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Sales" styleClass="metric-trend-pill,trend-positive"/></HBox>
            <Label fx:id="kpiTotalRevenue" text="₹ 0.00" styleClass="metric-value"/>
            <Label text="Net Sales Turnover" wrapText="true" styleClass="metric-note"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-red" GridPane.columnIndex="3">
          <StackPane fx:id="kpiExpenseIcon" styleClass="standard-kpi-icon"/>
          <VBox spacing="3" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT"><Label text="Total Expenses" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Cost" styleClass="metric-trend-pill,trend-negative"/></HBox>
            <Label fx:id="kpiTotalExpense" text="₹ 0.00" styleClass="metric-value"/>
            <Label text="Purchases + Overhead" wrapText="true" styleClass="metric-note"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,kpi-teal" GridPane.columnIndex="4">
          <StackPane fx:id="kpiProfitIcon" styleClass="standard-kpi-icon"/>
          <VBox spacing="3" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT"><Label text="Net Profit / Loss" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Net" styleClass="metric-trend-pill,trend-info"/></HBox>
            <Label fx:id="kpiNetProfit" text="₹ 0.00" styleClass="metric-value"/>
            <Label text="Net Operating Margin" wrapText="true" styleClass="metric-note"/>
          </VBox>
        </HBox>
      </GridPane>

      <HBox spacing="8" alignment="CENTER_LEFT" styleClass="approved-card,gl-period-bar">
        <Label text="Accounting Period:" styleClass="field-label"/>
        <ComboBox fx:id="cmbPeriodPreset" prefWidth="150" styleClass="approved-combo"/>
        <Label text="From Date:" styleClass="field-label"/>
        <DatePicker fx:id="dpFromDate" promptText="From Date" prefWidth="164"/>
        <Label text="To Date:" styleClass="field-label"/>
        <DatePicker fx:id="dpToDate" promptText="To Date" prefWidth="164"/>
        <Button fx:id="btnApplyPeriod" text="Apply Period" onAction="#applyPeriodFilter" styleClass="approved-button,approved-primary-button"/>
        <Button fx:id="btnClearPeriod" text="All Time" onAction="#clearPeriodFilter" styleClass="approved-button,approved-secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblActivePeriodInfo" text="Showing: All Time" styleClass="page-subtitle"/>
      </HBox>
    </VBox>
  </top>

  <center>
    <TabPane fx:id="glTabPane" styleClass="approved-tab-pane,erp-tab-pane">
      <tabs>
        <Tab text="Journal Vouchers" closable="false">
          <VBox spacing="8" styleClass="approved-card">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <TextField fx:id="txtJournalSearch" promptText="Search voucher no, account code/name, narration, reference..." HBox.hgrow="ALWAYS"/>
              <ComboBox fx:id="cmbVoucherFilter" promptText="Filter by Type" prefWidth="160"/>
              <ComboBox fx:id="cmbQuickBookFilter" promptText="Book View" prefWidth="165"/>
              <Button fx:id="btnJournalRefresh" text="Refresh" onAction="#refreshJournals" styleClass="approved-button,approved-secondary-button"/>
            </HBox>
            <SplitPane fx:id="journalSplit" VBox.vgrow="ALWAYS" dividerPositions="1.0" styleClass="register-split-pane">
              <VBox spacing="6">
                <TableView fx:id="tblJournals" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
                  <columns>
                    <TableColumn fx:id="colEntryNumber" text="Voucher No."/>
                    <TableColumn fx:id="colEntryDate" text="Date"/>
                    <TableColumn fx:id="colEntryType" text="Type"/>
                    <TableColumn fx:id="colReferenceNo" text="Ref Document"/>
                    <TableColumn fx:id="colNarration" text="Narration"/>
                    <TableColumn fx:id="colTotalDebit" text="Debit (₹)"/>
                    <TableColumn fx:id="colTotalCredit" text="Credit (₹)"/>
                    <TableColumn fx:id="colStatus" text="Status"/>
                    <TableColumn fx:id="colActions" text="Actions" sortable="false"/>
                  </columns>
                  <placeholder>
                    <VBox alignment="CENTER" spacing="8">
                      <Label text="No Journal Entries Found" styleClass="empty-title"/>
                      <Label text="Post a new manual journal voucher or record invoices." styleClass="empty-note"/>
                    </VBox>
                  </placeholder>
                </TableView>
                <HBox fx:id="journalPaginationHost" alignment="CENTER_RIGHT"/>
              </VBox>
              <VBox fx:id="journalDetailDrawer" visible="false" managed="false" spacing="9" prefWidth="430" minWidth="370" maxWidth="480" styleClass="approved-card,detail-drawer">
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <VBox HBox.hgrow="ALWAYS">
                    <Label text="Journal Voucher Details" styleClass="section-title"/>
                    <Label text="Double-Entry Financial Audit" styleClass="page-subtitle"/>
                  </VBox>
                  <Button fx:id="btnDrawerAudit" text="Audit Trail" onAction="#auditSelected" styleClass="approved-button,approved-secondary-button"/>
                  <Button fx:id="btnCloseJournalDrawer" text="Close" onAction="#closeJournalDetails" styleClass="secondary-button,drawer-close-button,approved-button,approved-secondary-button"/>
                </HBox>
                <Separator/>
                <VBox spacing="6" styleClass="drawer-summary-card">
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Voucher No:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerVoucherNo" text="-" styleClass="meta-value-bold"/>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Voucher Date:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerDate" text="-" styleClass="meta-value"/>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Type:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerType" text="-" styleClass="status-pill"/>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Ref Document:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerRef" text="-" styleClass="meta-value"/>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Posting Status:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerStatus" text="POSTED" styleClass="status-pill,status-positive"/>
                  </HBox>
                </VBox>
                <VBox spacing="4" styleClass="drawer-summary-card">
                  <Label text="Narration" styleClass="meta-label"/>
                  <Label fx:id="lblDrawerNarration" text="-" wrapText="true" styleClass="meta-value"/>
                </VBox>
                <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="drawer-summary-card">
                  <Label text="Double-Entry Breakdown (All Legs)" styleClass="section-title-sm"/>
                  <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblDrawerDrHead" text="Dr. Account:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerDrAmount" text="₹ 0.00" styleClass="meta-value-bold,text-primary"/>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblDrawerCrHead" text="Cr. Account:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDrawerCrAmount" text="₹ 0.00" styleClass="meta-value-bold,text-success"/>
                  </HBox>
                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="erp-clean-scroll">
                    <VBox fx:id="vboxDrawerLines" spacing="4"/>
                  </ScrollPane>
                  <Separator/>
                  <HBox alignment="CENTER_LEFT">
                    <Label text="Audit Check:" styleClass="meta-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="BALANCED (Dr = Cr)" styleClass="status-pill,status-positive"/>
                  </HBox>
                </VBox>
                <HBox spacing="6" alignment="CENTER_RIGHT">
                  <Button fx:id="btnPostDraft" text="Post Draft" onAction="#postSelectedDraft" visible="false" managed="false" styleClass="approved-button,approved-success-button"/>
                  <Button fx:id="btnReverseVoucher" text="Reverse" onAction="#reverseSelectedVoucher" styleClass="approved-button,approved-danger-ghost-button"/>
                  <Button fx:id="btnCopyVoucher" text="Copy No" onAction="#copyVoucherNumber" styleClass="approved-button,approved-secondary-button"/>
                  <Button fx:id="btnOpenLinkedDoc" text="Open Document" onAction="#openLinkedDocument" styleClass="primary-action,approved-button,approved-primary-button"/>
                </HBox>
              </VBox>
            </SplitPane>
          </VBox>
        </Tab>

        <Tab text="Chart of Accounts" closable="false">
          <VBox spacing="8" styleClass="approved-card">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <TextField fx:id="txtAccountSearch" promptText="Search account code, name, category..." HBox.hgrow="ALWAYS"/>
              <ComboBox fx:id="cmbAccountFilter" promptText="Filter by Category" prefWidth="160"/>
              <CheckBox fx:id="chkShowInactiveAccounts" text="Show Inactive" onAction="#refreshJournals" styleClass="approved-checkbox"/>
              <Button fx:id="btnNewAccount" text="New Account" onAction="#openNewAccountDialog" styleClass="approved-button,approved-primary-button"/>
              <Button fx:id="btnEditAccount" text="Edit Account" onAction="#editSelectedAccount" styleClass="approved-button,approved-secondary-button"/>
              <Button fx:id="btnViewAccountLedger" text="View Ledger" onAction="#openSelectedAccountLedger" styleClass="approved-button,approved-secondary-button"/>
            </HBox>
            <TableView fx:id="tblAccounts" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
              <columns>
                <TableColumn fx:id="colAccountCode" text="A/c Code"/>
                <TableColumn fx:id="colAccountName" text="Account Name"/>
                <TableColumn fx:id="colAccountType" text="Category"/>
                <TableColumn fx:id="colAccountSubtype" text="Subtype"/>
                <TableColumn fx:id="colOpeningBalance" text="Opening (₹)"/>
                <TableColumn fx:id="colCurrentBalance" text="Balance (₹)"/>
                <TableColumn fx:id="colAccountActive" text="Active"/>
              </columns>
              <placeholder>
                <VBox alignment="CENTER" spacing="8"><Label text="Chart of Accounts is empty" styleClass="empty-title"/></VBox>
              </placeholder>
            </TableView>
            <Label text="Tip: Select any account and click 'View Ledger' (or right-click a row) to open its full chronological Account Ledger Statement with running Dr/Cr balance." styleClass="muted-text"/>
          </VBox>
        </Tab>

        <Tab text="Trial Balance" closable="false">
          <VBox spacing="8" styleClass="approved-card">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <TextField fx:id="txtTbSearch" promptText="Search account head, code, type..." HBox.hgrow="ALWAYS"/>
              <Button fx:id="btnTbViewLedger" text="View Ledger" onAction="#openSelectedTbLedger" styleClass="approved-button,approved-secondary-button"/>
              <Button fx:id="btnExportTb" text="Export Excel" onAction="#exportStatement" styleClass="approved-button,approved-secondary-button"/>
            </HBox>
            <TableView fx:id="tblTrialBalance" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
              <columns>
                <TableColumn fx:id="colTbCode" text="Code"/>
                <TableColumn fx:id="colTbName" text="Account Head"/>
                <TableColumn fx:id="colTbType" text="Type"/>
                <TableColumn fx:id="colTbOpening" text="Opening (₹)"/>
                <TableColumn fx:id="colTbDebit" text="Debit (₹)"/>
                <TableColumn fx:id="colTbCredit" text="Credit (₹)"/>
                <TableColumn fx:id="colTbClosing" text="Closing (₹)"/>
              </columns>
              <placeholder>
                <VBox alignment="CENTER" spacing="8"><Label text="No trial balance data" styleClass="empty-title"/></VBox>
              </placeholder>
            </TableView>
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="gl-totals-strip">
              <Label fx:id="lblTbTotalOpening" text="Total Opening: ₹ 0.00" styleClass="comm-section-heading,comm-heading-indigo"/>
              <Label fx:id="lblTbTotalDebit" text="Total Debit: ₹ 0.00" styleClass="comm-section-heading,comm-heading-blue"/>
              <Label fx:id="lblTbTotalCredit" text="Total Credit: ₹ 0.00" styleClass="comm-section-heading,comm-heading-success"/>
              <Label fx:id="lblTbTotalClosing" text="Net Closing: ₹ 0.00" styleClass="comm-section-heading,comm-heading-amber"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblTbBalancePill" text="BALANCED (Dr = Cr)" styleClass="comm-status-badge,comm-status-sent"/>
            </HBox>
          </VBox>
        </Tab>

        <Tab text="Profit &amp; Loss" closable="false">
          <VBox spacing="8" styleClass="approved-card">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="gl-totals-strip">
              <Label fx:id="lblPlRevenue" text="Revenue: ₹ 0.00" styleClass="comm-section-heading,comm-heading-success"/>
              <Label fx:id="lblPlDirectCost" text="Direct Cost (COGS): ₹ 0.00" styleClass="comm-section-heading,comm-heading-amber"/>
              <Label fx:id="lblPlGrossProfit" text="Gross Profit: ₹ 0.00 (0.0%)" styleClass="comm-section-heading,comm-heading-blue"/>
              <Label fx:id="lblPlIndirectCost" text="Indirect Expenses: ₹ 0.00" styleClass="comm-section-heading,comm-heading-danger"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblPlNetProfit" text="Net Profit: ₹ 0.00 (0.0%)" styleClass="comm-status-badge,comm-status-sent"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
              <TextField fx:id="txtPlSearch" promptText="Search revenue or expense ledger..." HBox.hgrow="ALWAYS"/>
              <Button fx:id="btnPlViewLedger" text="View Ledger" onAction="#openSelectedPlLedger" styleClass="approved-button,approved-secondary-button"/>
            </HBox>
            <TableView fx:id="tblProfitLoss" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
              <columns>
                <TableColumn fx:id="colPlSection" text="Category"/>
                <TableColumn fx:id="colPlCode" text="Code"/>
                <TableColumn fx:id="colPlName" text="Account Head"/>
                <TableColumn fx:id="colPlSubtype" text="Subtype"/>
                <TableColumn fx:id="colPlAmount" text="Amount (₹)"/>
              </columns>
              <placeholder>
                <VBox alignment="CENTER" spacing="8"><Label text="No Profit &amp; Loss entries in selected period" styleClass="empty-title"/></VBox>
              </placeholder>
            </TableView>
          </VBox>
        </Tab>

        <Tab text="Balance Sheet" closable="false">
          <VBox spacing="8" styleClass="approved-card">
            <HBox spacing="12" VBox.vgrow="ALWAYS">
              <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card">
                <Label text="Assets (Application of Funds)" styleClass="section-title"/>
                <TableView fx:id="tblBsAssets" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
                  <columns>
                    <TableColumn fx:id="colBsAssetCode" text="Code"/>
                    <TableColumn fx:id="colBsAssetName" text="Account Head"/>
                    <TableColumn fx:id="colBsAssetSubtype" text="Subtype"/>
                    <TableColumn fx:id="colBsAssetBalance" text="Balance (₹)"/>
                  </columns>
                  <placeholder><Label text="No asset balances"/></placeholder>
                </TableView>
              </VBox>
              <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card">
                <Label text="Liabilities &amp; Equity (Sources of Funds)" styleClass="section-title"/>
                <TableView fx:id="tblBsLiabEquity" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table">
                  <columns>
                    <TableColumn fx:id="colBsLeCode" text="Code"/>
                    <TableColumn fx:id="colBsLeName" text="Account Head"/>
                    <TableColumn fx:id="colBsLeType" text="Type"/>
                    <TableColumn fx:id="colBsLeBalance" text="Balance (₹)"/>
                  </columns>
                  <placeholder><Label text="No liability or equity balances"/></placeholder>
                </TableView>
              </VBox>
            </HBox>
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="gl-totals-strip">
              <Label fx:id="lblBsTotalAssets" text="Total Assets: ₹ 0.00" styleClass="comm-section-heading,comm-heading-blue"/>
              <Label fx:id="lblBsTotalLiab" text="Liabilities: ₹ 0.00" styleClass="comm-section-heading,comm-heading-amber"/>
              <Label fx:id="lblBsTotalEquity" text="Equity + Net Profit: ₹ 0.00" styleClass="comm-section-heading,comm-heading-indigo"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblBsTallyPill" text="TALLIED (Assets = L + E)" styleClass="comm-status-badge,comm-status-sent"/>
            </HBox>
          </VBox>
        </Tab>
      </tabs>
    </TabPane>
  </center>
</BorderPane>
