<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ClientRegistryController"
      spacing="14" styleClass="clients-directory-page,approved-screen,erp-screen-root">

    <!-- 1. Header Identity Strip -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-page-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" prefWidth="42" prefHeight="42" styleClass="approved-page-icon,clients-page-icon"/>
        <VBox spacing="2">
            <Label text="Master Client Companies Registry &amp; Licensor Studio" styleClass="approved-page-title"/>
            <Label text="Centralized license issuance, inbound lead approvals, plan catalog pricing, and ARR revenue tracking"
                   styleClass="approved-page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRegisterClient" text="+ Register New Client" onAction="#handleRegisterClient"
                styleClass="approved-button,approved-primary-button"/>
        <Button fx:id="btnRefresh" text="Refresh" onAction="#handleRefresh"
                styleClass="approved-button,approved-secondary-button"/>
    </HBox>

    <!-- 2. KPI Summary Strip (Rule 6 compliant - canonical DashboardHome structure) -->
    <GridPane hgap="12" vgap="12" styleClass="approved-kpi-grid,approved-kpi,erp-kpi-section">
        <!-- KPI 1: Total Registered Clients -->
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
              styleClass="standard-kpi-card,sales-metric-card,sales-metric-total,kpi-sales,kpi-blue" GridPane.columnIndex="0">
            <StackPane fx:id="kpiTotalIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Registered Clients" styleClass="approved-kpi-caption,metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Clients" styleClass="metric-trend-pill,trend-neutral"/>
                </HBox>
                <Label fx:id="lblKpiTotal" text="0" styleClass="approved-kpi-value,metric-value"/>
                <Label text="Licensed Enterprise Accounts" styleClass="approved-kpi-note,metric-note"/>
            </VBox>
        </HBox>

        <!-- KPI 2: Active Subscriptions -->
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
              styleClass="standard-kpi-card,sales-metric-card,sales-metric-due,kpi-cash,kpi-green" GridPane.columnIndex="1">
            <StackPane fx:id="kpiActiveIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Active Subscriptions" styleClass="approved-kpi-caption,metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Active" styleClass="metric-trend-pill,trend-positive"/>
                </HBox>
                <Label fx:id="lblKpiActive" text="0" styleClass="approved-kpi-value,metric-value"/>
                <Label text="Valid Computer Bound Licenses" styleClass="approved-kpi-note,metric-note"/>
            </VBox>
        </HBox>

        <!-- KPI 3: Pending Lead Approvals -->
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
              styleClass="standard-kpi-card,sales-metric-card,sales-metric-today,kpi-purchase,kpi-orange" GridPane.columnIndex="2">
            <StackPane fx:id="kpiPendingLeadsIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Pending Approvals" styleClass="approved-kpi-caption,metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblKpiPendingTrend" text="Leads" styleClass="metric-trend-pill,trend-warning"/>
                </HBox>
                <Label fx:id="lblKpiPendingLeads" text="0" styleClass="approved-kpi-value,metric-value"/>
                <Label text="Inbound Self-Registration Requests" styleClass="approved-kpi-note,metric-note"/>
            </VBox>
        </HBox>

        <!-- KPI 4: Annual Recurring Revenue (ARR) -->
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
              styleClass="standard-kpi-card,sales-metric-card,sales-metric-pending,kpi-receivable,kpi-purple" GridPane.columnIndex="3">
            <StackPane fx:id="kpiArrIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Annual Recurring Revenue" styleClass="approved-kpi-caption,metric-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="ARR" styleClass="metric-trend-pill,trend-positive"/>
                </HBox>
                <Label fx:id="lblKpiArr" text="₹0.00" styleClass="approved-kpi-value,metric-value"/>
                <Label text="Projected License Run-Rate" styleClass="approved-kpi-note,metric-note"/>
            </VBox>
        </HBox>
    </GridPane>

    <!-- 3. Multi-Tab SuperAdmin Hub -->
    <TabPane fx:id="registryTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             styleClass="approved-tab-pane,erp-tabs">
        <tabs>
            <!-- TAB 1: Registered Clients -->
            <Tab fx:id="tabClients" text="Registered Clients">
                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <padding><Insets top="10" right="2" bottom="4" left="2"/></padding>
                    <!-- Search & Filter Strip -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="approved-card,clients-search-strip">
                        <TextField fx:id="txtSearch" promptText="Search by Company, Machine ID, Contact Person, or Phone..."
                                   HBox.hgrow="ALWAYS" styleClass="approved-input,search-field"/>
                        <ComboBox fx:id="cmbFilterStatus" promptText="Filter Status" prefWidth="160" styleClass="approved-combo"/>
                        <Button fx:id="btnResetFilter" text="Reset" onAction="#handleResetFilter"
                                styleClass="approved-button,approved-secondary-button"/>
                    </HBox>

                    <!-- Table (Rule 7: Dynamic percentage columns, Rule 12 zero truncation) -->
                    <VBox VBox.vgrow="ALWAYS" spacing="8" styleClass="approved-card,table-container-card">
                        <TableView fx:id="tableClients" VBox.vgrow="ALWAYS" styleClass="approved-table,clients-directory-table">
                            <placeholder>
                                <Label text="No registered clients found. Click '+ Register New Client' to issue a license." styleClass="muted-label"/>
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="colStatus" text="Status"/>
                                <TableColumn fx:id="colCompany" text="Client Company"/>
                                <TableColumn fx:id="colMachineId" text="Machine Hardware ID"/>
                                <TableColumn fx:id="colRemoteUrl" text="Remote Support URL"/>
                                <TableColumn fx:id="colLiveStatus" text="Live Telemetry"/>
                                <TableColumn fx:id="colContact" text="Contact &amp; Phone"/>
                                <TableColumn fx:id="colTier" text="Tier &amp; Users"/>
                                <TableColumn fx:id="colAnnualFee" text="Annual Fee (₹)"/>
                                <TableColumn fx:id="colValidUntil" text="Valid Until"/>
                                <TableColumn fx:id="colActions" text="Actions"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 2: Inbound Approval Requests -->
            <Tab fx:id="tabLeads" text="Approval Requests">
                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <padding><Insets top="10" right="2" bottom="4" left="2"/></padding>
                    <!-- Search & Filter Strip -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="approved-card,clients-search-strip">
                        <TextField fx:id="txtLeadSearch" promptText="Search leads by Company, Machine ID, Contact, or Phone..."
                                   HBox.hgrow="ALWAYS" styleClass="approved-input,search-field"/>
                        <ComboBox fx:id="cmbLeadFilterStatus" promptText="Filter Status" prefWidth="160" styleClass="approved-combo"/>
                        <Button fx:id="btnResetLeadFilter" text="Reset" onAction="#handleResetLeadFilter"
                                styleClass="approved-button,approved-secondary-button"/>
                    </HBox>

                    <!-- Leads Table -->
                    <VBox VBox.vgrow="ALWAYS" spacing="8" styleClass="approved-card,table-container-card">
                        <TableView fx:id="tableLeads" VBox.vgrow="ALWAYS" styleClass="approved-table,clients-directory-table">
                            <placeholder>
                                <Label text="No inbound registration leads found. Leads submitted from company login will appear here." styleClass="muted-label"/>
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="colLeadStatus" text="Status"/>
                                <TableColumn fx:id="colLeadCompany" text="Company Name"/>
                                <TableColumn fx:id="colLeadContact" text="Contact Person"/>
                                <TableColumn fx:id="colLeadPhone" text="Phone / WhatsApp"/>
                                <TableColumn fx:id="colLeadMachineId" text="Machine Hardware ID"/>
                                <TableColumn fx:id="colLeadTier" text="Requested Tier"/>
                                <TableColumn fx:id="colLeadDate" text="Requested At"/>
                                <TableColumn fx:id="colLeadActions" text="Actions"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 3: Subscription Plans & Commercial Settings -->
            <Tab fx:id="tabPlans" text="Subscription Plans &amp; Commercial Settings">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="approved-page-scroll">
                    <VBox spacing="14">
                        <padding><Insets top="10" right="4" bottom="16" left="4"/></padding>

                        <!-- Section A: Commercial Plans Catalog -->
                        <VBox spacing="8" styleClass="approved-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Commercial Subscription Plans Catalog" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnAddPlan" text="+ Add New Plan" onAction="#handleAddPlan"
                                        styleClass="approved-button,approved-primary-button"/>
                            </HBox>
                            <TableView fx:id="tablePlans" minHeight="180" prefHeight="220" styleClass="approved-table">
                                <placeholder>
                                    <Label text="No commercial plans found in catalog." styleClass="muted-label"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="colPlanCode" text="Tier Code"/>
                                    <TableColumn fx:id="colPlanName" text="Plan Name"/>
                                    <TableColumn fx:id="colPlanFee" text="Annual Price (₹)"/>
                                    <TableColumn fx:id="colPlanUsers" text="Max Users"/>
                                    <TableColumn fx:id="colPlanDays" text="Validity (Days)"/>
                                    <TableColumn fx:id="colPlanFeatures" text="Features"/>
                                    <TableColumn fx:id="colPlanStatus" text="Status"/>
                                    <TableColumn fx:id="colPlanActions" text="Actions"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Section B: Payment, Billing & Communication Settings -->
                        <VBox spacing="10" styleClass="approved-card">
                            <Label text="Cloud Commercial &amp; UPI Billing Configuration" styleClass="section-title"/>
                            <Label text="Configure payment VPA ID, support WhatsApp hotline, and automated message templates sent to clients"
                                   styleClass="muted-label"/>

                            <GridPane hgap="16" vgap="12">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="30"/>
                                    <ColumnConstraints percentWidth="70"/>
                                </columnConstraints>

                                <Label text="Primary Support WhatsApp *:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtCommPhone" promptText="e.g. 9537544008" styleClass="approved-input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Merchant UPI VPA (ID) *:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtCommVpa" promptText="e.g. jasviindustries@icici" styleClass="approved-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Payee Business Name:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtCommPayee" promptText="e.g. Jasvi Industries" styleClass="approved-input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="GST Taxation Rate (%):" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtCommGst" promptText="e.g. 18.00" styleClass="approved-input" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="WhatsApp Lead Response Template:" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <TextArea fx:id="txtCommLeadTpl" prefRowCount="2" minHeight="74" prefHeight="84" wrapText="true" styleClass="approved-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="WhatsApp License Issued Template:" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <TextArea fx:id="txtCommIssuedTpl" prefRowCount="2" minHeight="74" prefHeight="84" wrapText="true" styleClass="approved-input" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                            </GridPane>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button fx:id="btnSaveCommercialSettings" text="Save Commercial Settings" onAction="#handleSaveCommercialSettings"
                                        styleClass="approved-button,approved-primary-button"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </tabs>
    </TabPane>
</VBox>