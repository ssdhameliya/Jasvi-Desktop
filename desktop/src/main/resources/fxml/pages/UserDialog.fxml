<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.UserDialogController"
            prefWidth="1140" prefHeight="800" maxWidth="Infinity" maxHeight="Infinity"
            styleClass="entity-dialog,premium-entity-dialog,user-account-dialog,approved-ui,approved-screen,approved-screen-user-dialog,erp-screen-root,document-inspection-host">
    <top>
        <HBox fx:id="heroHeader" alignment="CENTER_LEFT" spacing="14"
              styleClass="erp-page-identity-header,approved-card,entity-dialog-header,premium-dialog-header">
            <StackPane fx:id="headerIconHolder" minWidth="44" minHeight="44" prefWidth="44" prefHeight="44"
                       styleClass="erp-page-header-icon,dialog-title-icon"/>
            <VBox spacing="2">
                <Label fx:id="lblTitle" text="User Account &amp; Privilege Wizard"
                       styleClass="section-title,erp-page-title,approved-strong-label,entity-dialog-title"/>
                <Label fx:id="lblSubtitle"
                       text="Employee identity • Role assignment &amp; access scope • Passwords, MFA authenticator and account security"
                       styleClass="muted-label,erp-page-subtitle,entity-dialog-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblStatusBadge" text="NEW USER ACCOUNT" styleClass="status-badge,status-info"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane,erp-dialog-scroll">
            <VBox spacing="14" styleClass="premium-dialog-content">
                <!-- Card 1: Employee Identity & Organizational Placement -->
                <VBox spacing="10" styleClass="approved-card,form-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="section-header-row">
                        <Label text="1. EMPLOYEE IDENTITY &amp; ORGANIZATIONAL PLACEMENT"
                               styleClass="dialog-section-title,approved-strong-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Staff Profile" styleClass="muted-label,field-hint-chip"/>
                    </HBox>
                    <GridPane hgap="16" vgap="10" styleClass="premium-form-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Full Name *" styleClass="field-label"/>
                            <TextField fx:id="txtFullName" promptText="Enter full employee name" styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Login Username *" styleClass="field-label"/>
                            <TextField fx:id="txtUsername" promptText="Enter unique login username" styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="2">
                            <Label text="Official Email Address *" styleClass="field-label"/>
                            <TextField fx:id="txtEmail" promptText="name@company.com" styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="Phone / Mobile *" styleClass="field-label"/>
                            <TextField fx:id="txtPhone" promptText="10-digit mobile number" styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Department" styleClass="field-label"/>
                            <TextField fx:id="txtDepartment" promptText="Accounts, Sales, Warehouse..." styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="2">
                            <Label text="Branch / Location" styleClass="field-label"/>
                            <TextField fx:id="txtBranch" promptText="Head Office, Factory, Surat..." styleClass="approved-input"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Card 2: Role Hierarchy & Privileges -->
                <VBox spacing="10" styleClass="approved-card,form-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="section-header-row">
                        <Label text="2. ROLE HIERARCHY &amp; ACCESS PRIVILEGES"
                               styleClass="dialog-section-title,approved-strong-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Role Privileges" styleClass="status-badge,status-info"/>
                    </HBox>
                    <GridPane hgap="16" vgap="10" styleClass="premium-form-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Assigned Role *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbRole" promptText="Select system role" maxWidth="Infinity" styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Access Level *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbAccess" promptText="Select access level" maxWidth="Infinity" styleClass="approved-input"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Card 3: Credentials & MFA Authentication Security -->
                <VBox spacing="10" styleClass="approved-card,form-section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="section-header-row">
                        <Label text="3. CREDENTIALS &amp; MFA AUTHENTICATION SECURITY"
                               styleClass="dialog-section-title,approved-strong-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Account Security" styleClass="status-badge,status-neutral"/>
                    </HBox>
                    <GridPane fx:id="gridPassword" hgap="16" vgap="10" styleClass="premium-form-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Password *" styleClass="field-label"/>
                            <StackPane maxWidth="Infinity">
                                <PasswordField fx:id="txtPassword" promptText="8+ characters, letters and numbers"
                                               maxWidth="Infinity" styleClass="approved-input,user-password-input"/>
                                <TextField fx:id="txtPasswordVisible" promptText="8+ characters, letters and numbers"
                                           maxWidth="Infinity" visible="false" managed="false" styleClass="approved-input,user-password-input"/>
                                <Button fx:id="btnPasswordEye" onAction="#togglePasswordVisibility" focusTraversable="false"
                                        styleClass="password-reveal-button,user-password-eye" StackPane.alignment="CENTER_RIGHT">
                                    <StackPane.margin><Insets right="7"/></StackPane.margin>
                                </Button>
                            </StackPane>
                        </VBox>
                        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Confirm Password *" styleClass="field-label"/>
                            <StackPane maxWidth="Infinity">
                                <PasswordField fx:id="txtConfirm" promptText="Repeat password exactly"
                                               maxWidth="Infinity" styleClass="approved-input,user-password-input"/>
                                <TextField fx:id="txtConfirmVisible" promptText="Repeat password exactly"
                                           maxWidth="Infinity" visible="false" managed="false" styleClass="approved-input,user-password-input"/>
                                <Button fx:id="btnConfirmEye" onAction="#toggleConfirmVisibility" focusTraversable="false"
                                        styleClass="password-reveal-button,user-password-eye" StackPane.alignment="CENTER_RIGHT">
                                    <StackPane.margin><Insets right="7"/></StackPane.margin>
                                </Button>
                            </StackPane>
                        </VBox>
                    </GridPane>

                    <Separator fx:id="sepPassword"/>

                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="account-flags-row">
                        <CheckBox fx:id="chkActive" text="Active Account" selected="true" styleClass="approved-checkbox"/>
                        <CheckBox fx:id="chkLocked" text="Account Locked" styleClass="approved-checkbox"/>
                        <CheckBox fx:id="chkMfa" text="Require Two-Factor (MFA)" styleClass="approved-checkbox"/>
                    </HBox>

                    <GridPane hgap="16" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="75"/>
                        </columnConstraints>
                        <Label text="MFA Policy:" GridPane.rowIndex="0" styleClass="field-help,muted-label"/>
                        <Label fx:id="lblMfaPolicy" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="field-label"/>
                        <Label text="Authenticator Status:" GridPane.rowIndex="1" styleClass="field-help,muted-label"/>
                        <Label fx:id="lblMfaStatus" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true" styleClass="field-label"/>
                    </GridPane>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button fx:id="btnResetMfa" text="Reset Authenticator" onAction="#resetAuthenticator"
                                visible="false" managed="false" styleClass="secondary-button,approved-secondary-button"/>
                        <Label text="Reset invalidates the old phone and requires a new QR enrollment at next sign-in."
                               wrapText="true" styleClass="field-help,muted-label"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="8" styleClass="entity-dialog-footer">
            <Label fx:id="lblMessage" wrapText="true" maxWidth="Infinity"
                   styleClass="validation-message,dialog-status-message" visible="false" managed="false"/>
            <HBox alignment="CENTER_RIGHT" spacing="12"
                  styleClass="entity-dialog-actions,premium-dialog-actions,erp-action-dock,approved-card">
                <Label fx:id="lblShortcuts" text="Shortcuts: [Ctrl+S] / [F10] Save  •  [Esc] Cancel"
                       styleClass="muted-label,shortcut-hint-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCancel" text="Cancel" onAction="#cancel"
                        styleClass="secondary-button,approved-secondary-button,approved-cancel-button" cancelButton="true"/>
                <Button fx:id="btnSave" text="Save User" onAction="#save"
                        styleClass="primary-button,approved-primary-button" defaultButton="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
