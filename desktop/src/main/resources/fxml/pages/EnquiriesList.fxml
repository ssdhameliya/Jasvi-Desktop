<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.EnquiriesController"
            styleClass="register-page,quotation-register-page,approved-ui,approved-screen,erp-screen-root">

    <top>
        <VBox spacing="10" styleClass="quotation-register-top,erp-transparent-section-stack">
            <padding><Insets top="14" right="14" bottom="0" left="14"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header">
                <StackPane fx:id="pageIcon" styleClass="quotation-page-icon"/>
                <VBox spacing="2">
                    <Label text="Website Enquiries &amp; Client Feedback" styleClass="screen-title"/>
                    <Label text="Manage Contact/RFQ leads and Client Feedback submissions separately with 1-click Quotation conversion" styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane prefWidth="340" minWidth="240" maxWidth="360" styleClass="erp-item-search-shell,register-header-search-shell">
                    <TextField fx:id="txtSearch" promptText="Search ref no, client, company, phone or product..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
                    <StackPane fx:id="searchIconBox" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon">
                        <StackPane.margin><Insets right="8"/></StackPane.margin>
                    </StackPane>
                </StackPane>
                <Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="register-action-button,register-refresh-button,approved-button,approved-teal-button,erp-button-teal"/>
            </HBox>

            <HBox spacing="12" styleClass="standard-kpi-row,quotation-metric-row,erp-kpi-section">
                <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="kpiTotalIcon" styleClass="standard-kpi-icon"/>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="Total Submissions" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="All" styleClass="metric-trend-pill,trend-neutral"/></HBox>
                        <Label fx:id="lblKpiTotal" text="0" styleClass="metric-value"/>
                        <Label fx:id="lblKpiBreakdown" text="0 RFQ / 0 Feedback" wrapText="true" styleClass="metric-note"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="kpiNewIcon" styleClass="standard-kpi-icon"/>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="New Leads" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Action" styleClass="metric-trend-pill,trend-warning"/></HBox>
                        <Label fx:id="lblKpiNew" text="0" styleClass="metric-value"/>
                        <Label text="Awaiting response" wrapText="true" styleClass="metric-note"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="kpiReviewIcon" styleClass="standard-kpi-icon"/>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="In Review" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Active" styleClass="metric-trend-pill,trend-info"/></HBox>
                        <Label fx:id="lblKpiReview" text="0" styleClass="metric-value"/>
                        <Label text="Technical sizing" wrapText="true" styleClass="metric-note"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" styleClass="standard-kpi-card,kpi-teal" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="kpiQuotedIcon" styleClass="standard-kpi-icon"/>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="Quoted" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="RFQ" styleClass="metric-trend-pill,trend-primary"/></HBox>
                        <Label fx:id="lblKpiQuoted" text="0" styleClass="metric-value"/>
                        <Label text="Quotation issued" wrapText="true" styleClass="metric-note"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" styleClass="standard-kpi-card,kpi-emerald" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="kpiWonIcon" styleClass="standard-kpi-icon"/>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="Won &amp; Rating" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Score" styleClass="metric-trend-pill,trend-success"/></HBox>
                        <Label fx:id="lblKpiWon" text="0" styleClass="metric-value"/>
                        <Label fx:id="lblKpiRating" text="Avg Rating: -" wrapText="true" styleClass="metric-note"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPaneEnquiries" tabClosingPolicy="UNAVAILABLE" styleClass="approved-tab-pane,register-tab-pane">
            <BorderPane.margin><Insets top="12" right="14" bottom="14" left="14"/></BorderPane.margin>
            <tabs>
                <Tab fx:id="tabEnquiries" text="Enquiries &amp; RFQs">
                    <VBox spacing="10" styleClass="quotation-register-workspace">
                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-filter-card">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Enquiry Type" styleClass="filter-label"/>
                                <ComboBox fx:id="cmbType" prefWidth="190" styleClass="approved-input"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Status" styleClass="filter-label"/>
                                <ComboBox fx:id="cmbStatus" prefWidth="180" styleClass="approved-input"/>
                            </HBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-warning-button"/>
                        </HBox>

                        <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="quotation-table-card">
                            <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,approved-table-modern,quotation-table">
                                <columns>
                                    <TableColumn fx:id="colNo" text="# Reference No" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colDate" text="Date" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colType" text="Type" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colClient" text="Client / Company" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colPhone" text="Contact &amp; Phone" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colDetails" text="Details" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colSource" text="Source" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colStatus" text="Status" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colQuotationNo" text="Quotation No." styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colActions" text="Actions" styleClass="approved-table-column" sortable="false" resizable="false"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="6">
                                        <Label text="No Website Enquiries found" styleClass="empty-title"/>
                                        <Label text="Contact, Product RFQ and Engineering Lab sizing inquiries appear here automatically." wrapText="true" styleClass="empty-note"/>
                                    </VBox>
                                </placeholder>
                            </TableView>

                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="quotation-export-bar">
                                <Label fx:id="lblFilteredSummary" styleClass="quotation-filtered-summary"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnPrevPage" text="&lt; Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/>
                                <Button fx:id="btnNextPage" text="Next &gt;" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </Tab>

                <Tab fx:id="tabFeedback" text="Client Feedback &amp; Ratings">
                    <VBox spacing="10" styleClass="quotation-register-workspace">
                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-filter-card">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Status" styleClass="filter-label"/>
                                <ComboBox fx:id="cmbFeedbackStatus" prefWidth="180" styleClass="approved-input"/>
                            </HBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnFeedbackReset" text="Reset" onAction="#resetFeedbackFilters" styleClass="approved-button,approved-warning-button"/>
                        </HBox>

                        <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="quotation-table-card">
                            <TableView fx:id="feedbackTable" VBox.vgrow="ALWAYS" styleClass="approved-table,approved-table-modern,quotation-table">
                                <columns>
                                    <TableColumn fx:id="colFbNo" text="# Reference No" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbDate" text="Date" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbClient" text="Client / Company" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbEmail" text="Email" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbRating" text="Rating" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbRemarks" text="Remarks" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbSource" text="Source" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbStatus" text="Status" styleClass="approved-table-column"/>
                                    <TableColumn fx:id="colFbActions" text="Actions" styleClass="approved-table-column" sortable="false" resizable="false"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="6">
                                        <Label text="No Client Feedback found" styleClass="empty-title"/>
                                        <Label text="Website client ratings and testimonials will appear here automatically." wrapText="true" styleClass="empty-note"/>
                                    </VBox>
                                </placeholder>
                            </TableView>

                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="quotation-export-bar">
                                <Label fx:id="lblFeedbackSummary" styleClass="quotation-filtered-summary"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnFeedbackPrevPage" text="&lt; Previous" onAction="#previousFeedbackPage" styleClass="approved-button,approved-secondary-button"/>
                                <Button fx:id="btnFeedbackNextPage" text="Next &gt;" onAction="#nextFeedbackPage" styleClass="approved-button,approved-secondary-button"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
