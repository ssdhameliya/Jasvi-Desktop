<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.LicenseRenewalDialogController"
            prefWidth="960" prefHeight="720" minWidth="880" minHeight="660"
            styleClass="entity-dialog,premium-entity-dialog,approved-ui">
    <top>
        <VBox spacing="6" styleClass="premium-dialog-header">
            <padding>
                <Insets top="18" right="24" bottom="14" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane fx:id="headerIconHolder" minWidth="36" minHeight="36" styleClass="auth-logo-badge"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Jasvi Desktop Subscription &amp; Machine Activation" styleClass="page-title"/>
                    <Label text="Direct Bharat UPI QR code renewal (0% fees) and enterprise machine-bound activation" styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="lblHeaderBadge" text="CHECKING..." styleClass="status-badge,badge-info"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox spacing="16" styleClass="premium-dialog-content">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <!-- Left Card: Instant Direct UPI QR Renewal -->
            <VBox spacing="12" styleClass="approved-card" HBox.hgrow="ALWAYS" maxWidth="420" alignment="TOP_CENTER">
                <padding>
                    <Insets top="16" right="18" bottom="16" left="18"/>
                </padding>
                <Label text="Instant Renewal via UPI" styleClass="field-label,email-transmission-field-bold"/>
                <Label text="Scan with Google Pay, PhonePe, or Paytm" styleClass="page-subtitle"/>

                <!-- QR Container -->
                <StackPane styleClass="barcode-sticker-mockup" minWidth="220" minHeight="220" maxWidth="240" maxHeight="240" alignment="CENTER">
                    <ImageView fx:id="imgUpiQr" fitWidth="220" fitHeight="220" preserveRatio="true"/>
                </StackPane>

                <VBox spacing="3" alignment="CENTER">
                    <Label fx:id="lblAmountDisplay" text="₹3,500 + GST = ₹4,130 / Year" styleClass="barcode-sticker-price"/>
                    <Label fx:id="lblVpaDisplay" text="VPA: jasviindustries@icici" styleClass="page-subtitle"/>
                </VBox>

                <Button fx:id="btnCopyUpiUri" text="Copy UPI Payment String" onAction="#handleCopyUpiString"
                        styleClass="approved-button,approved-secondary-button" maxWidth="240"/>
                <Label text="Once paid, your license automatically renews via cloud sync, or click Activate on This Computer below."
                       styleClass="page-subtitle" wrapText="true" textAlignment="CENTER"/>
            </VBox>

            <!-- Right Card: Machine Status & 1-Click Activation -->
            <VBox spacing="12" styleClass="approved-card" HBox.hgrow="ALWAYS" alignment="TOP_LEFT">
                <padding>
                    <Insets top="16" right="20" bottom="16" left="20"/>
                </padding>
                <Label text="Machine Hardware &amp; License Status" styleClass="field-label,email-transmission-field-bold"/>

                <VBox spacing="4" styleClass="email-transmission-sig-box">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Machine Hardware ID:" styleClass="settings-form-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnCopyMachineId" text="Copy ID" onAction="#handleCopyMachineId"
                                styleClass="approved-button,approved-secondary-button"/>
                    </HBox>
                    <TextField fx:id="txtMachineId" editable="false" styleClass="approved-input"/>
                </VBox>

                <GridPane hgap="12" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Company:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="settings-form-label"/>
                    <Label fx:id="lblCompany" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="field-label"/>

                    <Label text="Plan Tier:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="settings-form-label"/>
                    <Label fx:id="lblTier" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="field-label"/>

                    <Label text="Valid Until:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="settings-form-label"/>
                    <Label fx:id="lblValidUntil" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="field-label"/>

                    <Label text="Days Remaining:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="settings-form-label"/>
                    <Label fx:id="lblDaysRemaining" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="field-label"/>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnSelfActivateNow" text="Activate on This Computer Now" onAction="#handleSelfActivateNow"
                            styleClass="approved-button,approved-primary-button"/>
                </HBox>

                <Separator/>

                <Label text="Manual / Offline Activation" styleClass="field-label,email-transmission-field-bold"/>
                <Label text="Load your cryptographically signed license file (.jlic, .lic, or .json):" styleClass="page-subtitle"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnBrowseLicenseFile" text="Browse License File..." onAction="#handleBrowseLicenseFile"
                            styleClass="approved-button,approved-secondary-button"/>
                    <Label fx:id="lblSelectedFile" text="No file selected" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
                </HBox>

                <VBox spacing="4">
                    <Label text="Or paste raw license activation token:" styleClass="settings-form-label"/>
                    <TextArea fx:id="txtRawLicensePayload" prefRowCount="2" promptText="Paste Base64 or JSON license payload here..."
                              styleClass="approved-input" wrapText="true"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnApplyActivation" text="Apply &amp; Activate License" onAction="#handleApplyActivation"
                            styleClass="approved-button,approved-primary-button"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="premium-dialog-footer">
            <padding>
                <Insets top="10" right="24" bottom="12" left="24"/>
            </padding>
            <Button fx:id="btnClose" text="Close" onAction="#handleClose" styleClass="approved-button,approved-secondary-button"/>
        </HBox>
    </bottom>
</BorderPane>
