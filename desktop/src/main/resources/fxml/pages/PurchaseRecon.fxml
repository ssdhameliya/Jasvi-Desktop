<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseReconController" spacing="12" styleClass="recon-page,recon-register-page,approved-ui,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,approved-card"><StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Purchase Recon" styleClass="screen-title"/><Label text="Independent purchase invoice reconciliation against Bank Statement" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnBankStatement" text="Bank Statement" onAction="#openBankStatementWorkspace" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNew" text="New Purchase Recon" onAction="#newRecord" styleClass="approved-button,approved-primary-button"/></HBox>
 <HBox spacing="8" styleClass="standard-kpi-row,recon-metric-row,erp-kpi-section">
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-blue"><StackPane fx:id="kpiTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Total" styleClass="metric-trend-pill,trend-neutral"/></HBox><Label fx:id="kpiTotal" text="0" styleClass="metric-value"/><Label text="Purchase Recon records" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-red"><StackPane fx:id="kpiOpenIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Open" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Open" styleClass="metric-trend-pill,trend-negative"/></HBox><Label fx:id="kpiOpen" text="0" styleClass="metric-value"/><Label text="Not yet linked" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-orange"><StackPane fx:id="kpiPartialIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Partial" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Partial" styleClass="metric-trend-pill,trend-warning"/></HBox><Label fx:id="kpiPartial" text="0" styleClass="metric-value"/><Label text="Partially reconciled" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-green"><StackPane fx:id="kpiDoneIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Reconciled" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Done" styleClass="metric-trend-pill,trend-positive"/></HBox><Label fx:id="kpiDone" text="0" styleClass="metric-value"/><Label text="Fully linked" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-orange"><StackPane fx:id="kpiReviewIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Needs Review" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Review" styleClass="metric-trend-pill,trend-warning"/></HBox><Label fx:id="kpiReview" text="0" styleClass="metric-value"/><Label text="Tax difference review" wrapText="true" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-purple"><StackPane fx:id="kpiOutstandingIcon" styleClass="standard-kpi-icon"/><VBox spacing="3" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Outstanding" wrapText="true" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Balance" styleClass="metric-trend-pill,trend-info"/></HBox><Label fx:id="kpiOutstanding" text="₹ 0.00" styleClass="metric-value"/><Label text="Awaiting bank linkage" wrapText="true" styleClass="metric-note"/></VBox></HBox>
 </HBox>
 <HBox fx:id="workspaceRow" spacing="12" VBox.vgrow="ALWAYS">
  <VBox spacing="9" HBox.hgrow="ALWAYS" styleClass="approved-card"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Purchase Recon Register" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="txtSearch" promptText="Search PRC ref, supplier, GSTIN, invoice..." prefWidth="300" onAction="#applyFilters"/><ComboBox fx:id="cmbFilterStatus" prefWidth="145"/><Button fx:id="btnSearch" text="Search" onAction="#applyFilters" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportExcel" styleClass="approved-button,approved-secondary-button"/></HBox>
   <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table"><columns><TableColumn fx:id="colRef" text="System Ref"/><TableColumn fx:id="colDate" text="Invoice Date"/><TableColumn fx:id="colSupplier" text="Recon Supplier"/><TableColumn fx:id="colInvoice" text="Supplier Invoice"/><TableColumn fx:id="colValue" text="Invoice Value"/><TableColumn fx:id="colLinked" text="Linked Ref"/><TableColumn fx:id="colBalance" text="Balance"/><TableColumn fx:id="colStatus" text="Status"/><TableColumn fx:id="colSource" text="Source"/><TableColumn fx:id="colAction" text="Actions" sortable="false"/></columns></TableView>
   <HBox alignment="CENTER_LEFT" spacing="8" styleClass="table-footer"><Label fx:id="lblPageInfo" text="Showing 0 of 0 records" styleClass="register-record-count"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnPrevPage" text="‹ Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNextPage" text="Next ›" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/></HBox>
  </VBox>
  <VBox fx:id="editorPanel" spacing="10" styleClass="approved-card,recon-editor-panel">
   <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
   <!-- Compact Identity + Live Status Strip (No duplicate inner Close button) -->
   <HBox alignment="CENTER_LEFT" spacing="16" styleClass="approved-highlight-strip">
    <VBox spacing="1">
     <Label fx:id="lblEditorTitle" text="Purchase Recon Details" minWidth="-Infinity" styleClass="section-title"/>
     <Label fx:id="lblReference" text="Select a record or create a new one" minWidth="-Infinity" styleClass="muted-label"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox alignment="CENTER_LEFT" spacing="20">
     <VBox spacing="1"><Label text="Linked Amount" styleClass="metric-label"/><Label fx:id="lblLinked" text="₹ 0.00" styleClass="metric-value"/></VBox>
     <VBox spacing="1"><Label text="Balance" styleClass="metric-label"/><Label fx:id="lblBalance" text="₹ 0.00" styleClass="metric-value"/></VBox>
     <VBox spacing="1"><Label text="Status" styleClass="metric-label"/><Label fx:id="lblStatus" text="OPEN" styleClass="approved-status"/></VBox>
    </HBox>
   </HBox>

   <!-- Balanced Content-Adaptive 2-Panel Form (Zero Giant Voids, Zero Ellipsis) -->
   <HBox spacing="14">
    <!-- Left Panel (~60%): Core Supplier, Invoice, Financials, Taxes & Compact Notes -->
    <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="approved-card">
     <HBox alignment="BOTTOM_LEFT" spacing="10">
      <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Recon Supplier" styleClass="field-label"/><ComboBox fx:id="cmbSupplier" maxWidth="Infinity" styleClass="approved-input"/></VBox>
      <Button fx:id="btnAddSupplier" text="Add Recon Supplier" onAction="#addSupplier" minWidth="-Infinity" styleClass="approved-button,approved-secondary-button"/>
     </HBox>

     <GridPane hgap="12" vgap="8">
      <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
      <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="Supplier Invoice No." styleClass="field-label"/><TextField fx:id="txtInvoiceNo" promptText="e.g. SUP/2026/0142" styleClass="approved-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Invoice Date" styleClass="field-label"/><DatePicker fx:id="dpInvoiceDate" maxWidth="Infinity" styleClass="approved-input"/></VBox>
     </GridPane>

     <GridPane hgap="12" vgap="8">
      <columnConstraints><ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/></columnConstraints>
      <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="Taxable Value" styleClass="field-label"/><TextField fx:id="txtTaxable" styleClass="approved-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Invoice Value" styleClass="field-label"/><TextField fx:id="txtInvoiceValue" styleClass="approved-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0"><Label text="Other / Rounding" styleClass="field-label"/><TextField fx:id="txtOther" styleClass="approved-input"/></VBox>

      <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="CGST" styleClass="field-label"/><TextField fx:id="txtCgst" styleClass="approved-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="SGST / UTGST" styleClass="field-label"/><TextField fx:id="txtSgst" styleClass="approved-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1"><Label text="IGST" styleClass="field-label"/><TextField fx:id="txtIgst" styleClass="approved-input"/></VBox>
     </GridPane>

     <Label fx:id="lblTaxWarning" text="" visible="false" managed="false" wrapText="true" styleClass="import-warning-text"/>

     <VBox spacing="4">
      <Label text="Notes" styleClass="field-label"/>
      <TextArea fx:id="txtNotes" prefRowCount="3" minHeight="72" prefHeight="78" maxHeight="94" wrapText="true" promptText="Optional reconciliation remarks or supplier bill references..."/>
     </VBox>
    </VBox>

    <!-- Right Panel (~40%): Proportionate Attachments + Bank Statement Links -->
    <VBox spacing="10" minWidth="380" prefWidth="420" HBox.hgrow="SOMETIMES">
     <VBox spacing="8" styleClass="approved-card">
      <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Attachments" minWidth="-Infinity" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Stored on server" minWidth="-Infinity" styleClass="muted-label"/></HBox>
      <ListView fx:id="listAttachments" minHeight="96" prefHeight="110" maxHeight="128"/>
      <HBox spacing="8"><Button fx:id="btnAttachmentAdd" text="Add" onAction="#addAttachment" minWidth="-Infinity" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnAttachmentPreview" text="Preview" onAction="#previewAttachment" minWidth="-Infinity" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnAttachmentDelete" text="Delete" onAction="#deleteAttachment" minWidth="-Infinity" styleClass="approved-button,approved-danger-button"/></HBox>
     </VBox>

     <VBox spacing="8" styleClass="approved-card">
      <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Bank Statement Links" minWidth="-Infinity" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Linked entries" minWidth="-Infinity" styleClass="muted-label"/></HBox>
      <ListView fx:id="listBankLinks" minHeight="96" prefHeight="110" maxHeight="128"/>
      <HBox spacing="8"><Button fx:id="btnOpenStatement" text="Open Bank Statement" onAction="#openBankStatement" minWidth="-Infinity" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnOpenBankEntry" text="Open Bank Entry" onAction="#openBankEntry" minWidth="-Infinity" styleClass="approved-button,approved-secondary-button"/></HBox>
     </VBox>
    </VBox>
   </HBox>

   <!-- Bottom Action Dock -->
   <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="inspection-action-dock">
    <Button text="Cancel" onAction="#closeEditor" minWidth="-Infinity" styleClass="approved-button,approved-danger-ghost-button"/>
    <Button fx:id="btnSave" text="Save Purchase Recon" onAction="#saveRecord" minWidth="-Infinity" styleClass="approved-button,approved-primary-button"/>
   </HBox>
  </VBox>
 </HBox>
</VBox>
