<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.GlobalAuditController" spacing="12" styleClass="approved-ui,approved-screen,erp-screen-root,audit-page">
    <padding><Insets top="14" right="16" bottom="16" left="16"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header">
        <StackPane styleClass="erp-page-header-icon"><Label text="◷" styleClass="erp-page-header-symbol"/></StackPane>
        <VBox spacing="2"><Label text="Global Audit Trail" styleClass="screen-title"/><Label text="Central business-change history across all ERP modules" styleClass="screen-subtitle"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Append-only" styleClass="audit-badge,audit-green"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>
    <GridPane fx:id="auditKpiGrid" hgap="10" vgap="10" styleClass="erp-kpi-section,audit-kpi-section">
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" GridPane.columnIndex="0" styleClass="standard-kpi-card,kpi-purple,audit-kpi-card,audit-summary-purple">
            <StackPane fx:id="auditTotalIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Business Events" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption,audit-kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="All" styleClass="metric-trend-pill,trend-neutral"/>
                </HBox>
                <Label fx:id="lblTotal" text="0" styleClass="metric-value,approved-kpi-value,audit-kpi-value,audit-color-purple"/>
                <Label text="All normalized events" wrapText="true" styleClass="metric-note,approved-kpi-note,audit-kpi-subtitle"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" GridPane.columnIndex="1" styleClass="standard-kpi-card,kpi-green,audit-kpi-card,audit-summary-green">
            <StackPane fx:id="auditChangesIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Record Changes" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption,audit-kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Lifecycle" styleClass="metric-trend-pill,trend-positive"/>
                </HBox>
                <Label fx:id="lblChanges" text="0" styleClass="metric-value,approved-kpi-value,audit-kpi-value,audit-color-green"/>
                <Label text="Create / update / lifecycle" wrapText="true" styleClass="metric-note,approved-kpi-note,audit-kpi-subtitle"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" GridPane.columnIndex="2" styleClass="standard-kpi-card,kpi-orange,audit-kpi-card,audit-summary-orange">
            <StackPane fx:id="auditFinancialIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Financial Events" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption,audit-kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Finance" styleClass="metric-trend-pill,trend-warning"/>
                </HBox>
                <Label fx:id="lblFinancial" text="0" styleClass="metric-value,approved-kpi-value,audit-kpi-value,audit-color-orange"/>
                <Label text="Payments / refunds / recon" wrapText="true" styleClass="metric-note,approved-kpi-note,audit-kpi-subtitle"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" GridPane.columnIndex="3" styleClass="standard-kpi-card,kpi-blue,audit-kpi-card,audit-summary-blue">
            <StackPane fx:id="auditDocumentsIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Document Events" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption,audit-kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Documents" styleClass="metric-trend-pill,trend-info"/>
                </HBox>
                <Label fx:id="lblDocuments" text="0" styleClass="metric-value,approved-kpi-value,audit-kpi-value,audit-color-blue"/>
                <Label text="PDF / Excel / attachments" wrapText="true" styleClass="metric-note,approved-kpi-note,audit-kpi-subtitle"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" GridPane.columnIndex="4" styleClass="standard-kpi-card,kpi-teal,audit-kpi-card,audit-summary-teal">
            <StackPane fx:id="auditCommunicationsIcon" styleClass="standard-kpi-icon,approved-kpi-icon"/>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Communications" wrapText="true" styleClass="metric-title,metric-label,approved-kpi-caption,audit-kpi-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Activity" styleClass="metric-trend-pill,trend-neutral"/>
                </HBox>
                <Label fx:id="lblCommunications" text="0" styleClass="metric-value,approved-kpi-value,audit-kpi-value,audit-color-teal"/>
                <Label text="Email / WhatsApp" wrapText="true" styleClass="metric-note,approved-kpi-note,audit-kpi-subtitle"/>
            </VBox>
        </HBox>
    </GridPane>
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="audit-filter-bar">
        <ComboBox fx:id="cmbModule" promptText="All Modules"/>
        <ComboBox fx:id="cmbAction" promptText="All Actions"/>
        <ComboBox fx:id="cmbUser" promptText="All Users"/>
        <TextField fx:id="txtReference" promptText="Reference"/>
        <TextField fx:id="txtSearch" promptText="Search field, detail or user" HBox.hgrow="ALWAYS"/>
        <Button text="Clear" onAction="#clearFilters" styleClass="secondary-button"/>
        <Button text="Apply" onAction="#refresh" styleClass="primary-button"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,audit-table,erp-table-profile-administration">
        <columns>
            <TableColumn fx:id="colDate" text="Date / Time"/>
            <TableColumn fx:id="colModule" text="Module"/>
            <TableColumn fx:id="colRecordType" text="Record Type"/>
            <TableColumn fx:id="colReference" text="Reference"/>
            <TableColumn fx:id="colAction" text="Action"/>
            <TableColumn fx:id="colCategory" text="Category"/>
            <TableColumn fx:id="colField" text="Changed Field"/>
            <TableColumn fx:id="colOld" text="Old Value"/>
            <TableColumn fx:id="colNew" text="New Value"/>
            <TableColumn fx:id="colUser" text="User"/>
            <TableColumn fx:id="colSource" text="Source"/>
            <TableColumn fx:id="colView" text="View" sortable="false"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="8"><Label fx:id="lblPage" text="0 events" styleClass="muted-label"/><Button text="Previous" onAction="#previousPage" styleClass="secondary-button"/><Button text="Next" onAction="#nextPage" styleClass="secondary-button"/></HBox>
</VBox>
